#!/usr/bin/env bash
#
# limen-install — set up / update a dev machine's global aqua toolchain.
# The global toolchain is ONE tool: limen, the project scaffolder, installed
# from farcloser/limen's GitHub releases through the local aqua registry
# embedded below — no separate config repo, no fetch. (GITHUB_TOKEN is honored
# when set: API rate limits.)
#
# Per-project setup is separate: `aqua policy allow && aqua i -l` inside a repo.

set -euo pipefail

# On Windows (git-bash), aqua and its installer root at %LOCALAPPDATA%
# (= $HOME/AppData/Local), not XDG's ~/.local/share — align with aqua's own
# convention rather than pinning against it. That is the ONLY windows
# accommodation needed: git-bash converts POSIX-form env values (paths and
# even colon-lists) to native form when spawning native binaries, so the
# config/policy exports below reach aqua.exe correctly as they are.
case "$OSTYPE" in
  msys*|cygwin*)
    # shellcheck disable=SC2016
    AQUA_BIN_EXPR='${AQUA_ROOT_DIR:-$HOME/AppData/Local/aquaproj-aqua}/bin' ;;
  *)
    # shellcheck disable=SC2016
    AQUA_BIN_EXPR='${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin' ;;
esac
readonly AQUA_BIN_EXPR

# Every tool this script runs is the system's, for the whole run. On a machine
# that already has limen, cat, mkdir, mktemp, rm, curl and the rest of coreutils
# on PATH are aqua proxies, and a proxy parses the global config before it runs
# anything: `cat > "$AQUA_GLOBAL_CONFIG" <<YAML` truncates that file before cat
# starts, the proxy reads an empty YAML and fails, and set -e leaves the file
# empty, which breaks every proxy on the machine. aqua's own directory comes
# next, ahead of any other aqua (a brew one would break every recipe), for
# `aqua` and, once installed, `limen`.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:$(eval "echo \"$AQUA_BIN_EXPR\""):$PATH"
export PATH

# The version is Renovate-managed (see renovate.json5); the sha256 of the
# installer script, which must change with it, is recomputed on Renovate's
# branches by update-installer-checksum.yaml — the pair always moves together.
# renovate: depName=aquaproj/aqua-installer
readonly AQUA_INSTALLER_VERSION="v4.1.0"
readonly AQUA_INSTALLER_SHA256="4d3e513d42f425609c1ead6ecd40b9c62492011979dfe23d7012428a59efbe82"

# Keep in step with setup-aqua's pin. No checksum companion: the verified
# installer above performs this download. Renovate-managed (see renovate.json5).
# renovate: depName=aquaproj/aqua
readonly AQUA_VERSION="v2.64.0"

# The default locations, kept in UNEXPANDED form: this exact text goes into the
# shell rc, so the rc keeps tracking $HOME / XDG_CONFIG_HOME at shell startup
# (and survives dotfile syncs across machines) instead of freezing today's
# absolute paths. The script evaluates them for its own use below.
# shellcheck disable=SC2016
readonly CONFIG_EXPR='${XDG_CONFIG_HOME:-$HOME/.config}/aqua/aqua.yaml'
# shellcheck disable=SC2016
readonly POLICY_EXPR='${XDG_CONFIG_HOME:-$HOME/.config}/aqua/aqua-policy.yaml'

# Overridable for ONE reason: this is aqua's OWN env var. If aqua is already told
# where its global config lives, we must write the file there so aqua reads it.
# Exported once here so `aqua` (a child process) inherits it everywhere below.
# The preset is remembered: when set, the rc must carry the actual custom path —
# the default expression above would point at files that are not there.
AQUA_GLOBAL_CONFIG_PRESET="${AQUA_GLOBAL_CONFIG:-}"
readonly AQUA_GLOBAL_CONFIG_PRESET
export AQUA_GLOBAL_CONFIG="${AQUA_GLOBAL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/aqua/aqua.yaml}"
CONFIG_DIR="$(dirname "$AQUA_GLOBAL_CONFIG")"
readonly CONFIG_DIR
readonly POLICY_FILE="$CONFIG_DIR/aqua-policy.yaml"

# The global policy must be visible to EVERY aqua invocation — aqua enforces
# policy at exec time, not just install time, so without this even running
# `limen` fails with "this package isn't allowed". Appended, never assigned:
# aqua accepts a colon-separated list, and per-project policies prepend theirs.
export AQUA_POLICY_CONFIG="$POLICY_FILE${AQUA_POLICY_CONFIG:+:$AQUA_POLICY_CONFIG}"

SHELL_CHANGED=0   # set to 1 if we modify the shell rc (→ advise opening a new shell)

# The nightly update job, macOS only for now: a launchd agent that fetches the
# latest release of this script over https and runs it. The runner lives under
# XDG data, the agent's plist and log where launchd and Console look. Under
# launchd the rc is never sourced, so the runner exports aqua's variables
# itself, and LIMEN_INSTALL_NIGHTLY tells this script it is that run.
readonly NIGHTLY_LABEL="world.farcloser.limen-install"
readonly NIGHTLY_HOUR=4 NIGHTLY_MINUTE=17
NIGHTLY_RUNNER="${XDG_DATA_HOME:-$HOME/.local/share}/limen-install/nightly"
readonly NIGHTLY_RUNNER
readonly NIGHTLY_PLIST="$HOME/Library/LaunchAgents/$NIGHTLY_LABEL.plist"
readonly NIGHTLY_LOG="$HOME/Library/Logs/limen-install.log"
LAUNCHD_FAILED=0  # set to 1 when a service could not be loaded (→ exit 1 at the end)
is_macos() { [ "$(uname -s)" = Darwin ]; }

log() { printf '› %s\n' "$*"; }
ok()  { printf '✓ %s\n' "$*"; }
err() { printf '✗ %s\n' "$*" >&2; }

verify_sha256() {  # $1=file $2=expected
  # No single digest tool exists everywhere: linux and windows git-bash ship
  # coreutils sha256sum, macOS ships perl shasum.
  if command -v sha256sum >/dev/null 2>&1; then
    echo "$2  $1" | sha256sum -c - >/dev/null 2>&1 \
      || { err "checksum mismatch: ${1##*/}"; exit 1; }
  else
    echo "$2  $1" | shasum -a 256 -c - >/dev/null 2>&1 \
      || { err "checksum mismatch: ${1##*/}"; exit 1; }
  fi
}

install_aqua() {
  if command -v aqua >/dev/null 2>&1; then
    # Converge, do not skip: a re-run moves an existing aqua to the pin —
    # without this the version would stay frozen at whatever the machine got
    # first (this script is the update path too).
    aqua --log-level warn update-aqua "$AQUA_VERSION"
    ok "aqua ${AQUA_VERSION}"
    return
  fi
  log "installing aqua ${AQUA_VERSION} (installer ${AQUA_INSTALLER_VERSION})"
  local t; t="$(mktemp -d "${TMPDIR:-/tmp}/limen-install.XXXXXX")"
  curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors -o "$t/i" \
    "https://raw.githubusercontent.com/aquaproj/aqua-installer/${AQUA_INSTALLER_VERSION}/aqua-installer"
  verify_sha256 "$t/i" "$AQUA_INSTALLER_SHA256"
  chmod +x "$t/i"
  # Apple's mktemp ignores TMPDIR and lands in the per-user temp directory,
  # and the installer calls it bare: under a TMPDIR set on purpose (a sandbox
  # that denies that directory) it would die there. A shim first on the
  # child's PATH gives a bare call a template under TMPDIR; a call that
  # carries its own template is left alone.
  mkdir -p "$t/bin"
  cat > "$t/bin/mktemp" <<'SHIM'
#!/bin/sh
real="$(PATH=/usr/bin:/bin command -v mktemp)"
for a in "$@"; do case "$a" in -*) ;; *) exec "$real" "$@" ;; esac; done
exec "$real" "$@" "${TMPDIR:-/tmp}/aqua-installer.XXXXXX"
SHIM
  chmod +x "$t/bin/mktemp"
  PATH="$t/bin:$PATH" "$t/i" -v "$AQUA_VERSION"; rm -rf "$t"
  ok "aqua ${AQUA_VERSION} installed"
}

shell_rc() {
  case "${SHELL:-}" in
    */zsh|zsh)  echo "$HOME/.zshrc" ;;
    */bash|bash) echo "$HOME/.bashrc" ;;
    *)    echo "$HOME/.profile" ;;
  esac
}

# Every directory this script writes under, probed with a real file before the
# first step, so an unwritable target (a sandboxed job, a read-only home, a
# config directory owned by someone else) stops the run before it has installed
# or appended anything. A permission test is not enough: a sandbox denies the
# open, not the mode bits.
preflight_writes() {
  local rc p dir probe
  rc="$(shell_rc)"
  set -- "$CONFIG_DIR" "$(eval "echo \"$AQUA_BIN_EXPR\"")" "${rc%/*}"
  if is_macos; then
    set -- "$@" "${NIGHTLY_RUNNER%/*}" "${NIGHTLY_PLIST%/*}" "${NIGHTLY_LOG%/*}"
  fi
  for p in "$@"; do
    dir="$p"
    while [ -n "$dir" ] && [ ! -d "$dir" ]; do dir="${dir%/*}"; done
    : "${dir:=/}"
    if ! probe="$(mktemp "$dir/.limen-install.XXXXXX" 2>/dev/null)"; then
      err "cannot write under $dir"
      exit 1
    fi
    rm -f "$probe"
  done
}

ensure_shell_config() {
  local rc
  rc="$(shell_rc)"
  # Guard with the exact literal we write (grep -F): the expression contains a
  # "}" between "aquaproj-aqua" and "/bin", so any looser hand-written pattern
  # silently never matches and the block gets re-appended on every run.
  if ! grep -qF "$AQUA_BIN_EXPR" "$rc" 2>/dev/null; then
    # shellcheck disable=SC2016
    printf '\n# aqua\nexport PATH="%s:$PATH"\n' "$AQUA_BIN_EXPR" >> "$rc"
    SHELL_CHANGED=1
  fi
  # Default install → write the unexpanded expressions (rc stays $HOME/XDG
  # relative); preset AQUA_GLOBAL_CONFIG → write the actual custom paths.
  local config_value="$CONFIG_EXPR" policy_value="$POLICY_EXPR"
  if [ -n "$AQUA_GLOBAL_CONFIG_PRESET" ]; then
    config_value="$AQUA_GLOBAL_CONFIG"
    policy_value="$POLICY_FILE"
  fi
  if ! grep -qF 'AQUA_GLOBAL_CONFIG' "$rc" 2>/dev/null; then
    printf 'export AQUA_GLOBAL_CONFIG="%s"\n' "$config_value" >> "$rc"
    SHELL_CHANGED=1
  fi
  if ! grep -qF 'AQUA_POLICY_CONFIG' "$rc" 2>/dev/null; then
    # Appended, never assigned (see the export above) — a plain assignment here
    # would clobber per-project policies, or be clobbered by them.
    # shellcheck disable=SC2016
    printf 'export AQUA_POLICY_CONFIG="%s${AQUA_POLICY_CONFIG:+:$AQUA_POLICY_CONFIG}"\n' "$policy_value" >> "$rc"
    SHELL_CHANGED=1
  fi
}

# Renovate bumps the limen pin below, grouped with aqua.yaml's — do not
# hand-edit it out of step.
write_config() {
  mkdir -p "$CONFIG_DIR"

  cat > "$AQUA_GLOBAL_CONFIG" <<'YAML'
---
# Global aqua config — the machine toolset: limen, the project scaffolder,
# OpenSSH with security keys built in, and taciturn, the Secure Enclave
# ssh-agent. Written by limen-install; edits are overwritten on the next run.
checksum:
  enabled: true
  require_checksum: true
registries:
  - name: farcloser
    type: local
    path: registry.yaml
packages:
  - name: farcloser/limen@v0.12.0 # renovate: depName=farcloser/limen
    registry: farcloser
  - name: forkcloser/openssh@v10.6.1.2 # renovate: depName=forkcloser/openssh
    registry: farcloser
  - name: forkcloser/taciturn@v0.2.0 # renovate: depName=forkcloser/taciturn
    registry: farcloser
YAML

  # The registry entry mirrors what goreleaser publishes: per-platform tar.gz
  # archives named limen_<version>_<os>_<arch>.tar.gz plus a checksums.txt that
  # aqua pins from (see update-checksum below).
  cat > "$CONFIG_DIR/registry.yaml" <<'YAML'
---
# Written by limen-install; edits are overwritten on the next run.
packages:
  - type: github_release
    repo_owner: farcloser
    repo_name: limen
    description: Verify a repository against Farcloser engineering rules
    asset: limen_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: limen
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
      # Signature doctrine: verify whenever upstream publishes. The release
      # signs checksums.txt keyless from CI; the identity is the release
      # workflow at the exact tag, so a bundle signed by anything else fails.
      cosign:
        bundle:
          type: github_release
          asset: checksums.txt.sigstore.json
        opts:
          - --certificate-identity
          - https://github.com/farcloser/limen/.github/workflows/release.yaml@refs/tags/{{.Version}}
          - --certificate-oidc-issuer
          - https://token.actions.githubusercontent.com
    supported_envs:
      - darwin
      - linux
      - windows
  # OpenSSH with security keys built in, relocatable, darwin/arm64 only: aqua
  # skips the package elsewhere. The entry is the one forkcloser/openssh's
  # README carries; the release attests every asset and ships checksums.txt.
  - type: github_release
    repo_owner: forkcloser
    repo_name: openssh
    description: OpenSSH with security keys built in, relocatable, darwin/arm64 (forkcloser/openssh)
    asset: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: ssh
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh
      - name: ssh-agent
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-agent
      - name: ssh-add
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-add
      - name: ssh-keygen
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-keygen
      - name: ssh-keyscan
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-keyscan
      - name: scp
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/scp
      - name: sftp
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sftp
      - name: ssh-agent-install
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-agent-install
      - name: sshd-install
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sshd-install
      - name: sshd-uninstall
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sshd-uninstall
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
    github_artifact_attestations:
      signer_workflow: forkcloser/openssh/.github/workflows/release.yaml
    supported_envs:
      - darwin/arm64
  # taciturn, the ssh-agent for Secure Enclave keys the sessions sign and push
  # through, darwin/arm64 only. From v0.2.0 the archive carries Taciturn.app
  # and nothing else: the kernel refuses the binary's keychain entitlements
  # outside its signed bundle, so the binary lives inside it, and the agent
  # itself resolves that path when it installs its LaunchAgent. The v0.1
  # archives had the binary at the root. The release attests the asset and
  # ships checksums.txt.
  - type: github_release
    repo_owner: forkcloser
    repo_name: taciturn
    description: ssh-agent for Secure Enclave keys, with per-key policy (forkcloser/taciturn)
    asset: taciturn_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: taciturn
        src: Taciturn.app/Contents/MacOS/taciturn
    # aqua consults version_overrides only when the entry itself carries a
    # version_constraint; without this line every version takes the files above.
    version_constraint: semver(">= 0.2.0")
    version_overrides:
      - version_constraint: semver("< 0.2.0")
        files:
          - name: taciturn
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
    github_artifact_attestations:
      signer_workflow: forkcloser/taciturn/.github/workflows/release.yaml
    supported_envs:
      - darwin/arm64
YAML

  cat > "$POLICY_FILE" <<'YAML'
---
# Written by limen-install; edits are overwritten on the next run.
registries:
  - name: farcloser
    type: local
    path: registry.yaml
packages:
  - registry: farcloser
YAML

  ok "global config written: ${CONFIG_DIR} (aqua.yaml, registry.yaml, aqua-policy.yaml)"
}

install_tools() {
  aqua policy allow "$POLICY_FILE"
  (cd "$CONFIG_DIR" && aqua --log-level warn update-checksum --prune && aqua --log-level warn i -a)
  ok "scaffolder ready: $(limen version 2>/dev/null || echo 'open a new shell, then run: limen version')"
}

# The ssh-agent launchd agent runs the package by its real path (launchd has
# no aqua proxy to resolve), so an upgrade would leave it on the old binary,
# whose sk-helper then fails every signature. On macOS the agent is part of
# the toolset: when the loaded agent is not the pinned package — none loaded,
# an older one, a hand-unpacked one — the package's ssh-agent-install boots
# the label out, writes the plist to its own path and bootstraps it. Only a
# test holds back: the smoke installs into a throwaway HOME that shares the
# machine's launchd domain, and it says so with LIMEN_INSTALL_NO_LAUNCHD,
# which keeps every service, this one and the nightly job, unloaded.
readonly SSH_AGENT_LABEL="org.forkcloser.ssh_agent"
refresh_ssh_agent() {
  is_macos || return 0
  local pkg running
  pkg="$(cd "$CONFIG_DIR" && aqua which ssh-agent-install 2>/dev/null)" || return 0
  pkg="${pkg%/bin/ssh-agent-install}"
  # launchctl exits 113 for a label it does not know, which pipefail would
  # turn into this function's exit: an unloaded agent is a case, not an error.
  running="$({ launchctl print "gui/$(id -u)/$SSH_AGENT_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*\(/.*\)/libexec/ssh-agent-launchd$#\1#p' | head -n 1)"
  if [ "$running" = "$pkg" ]; then
    ok "ssh-agent: $SSH_AGENT_LABEL runs the pinned package"
    return 0
  fi
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "ssh-agent: LIMEN_INSTALL_NO_LAUNCHD is set; $SSH_AGENT_LABEL left as it is (${running:-not loaded})"
    return 0
  fi
  log "ssh-agent: $SSH_AGENT_LABEL ${running:+runs $running, }${running:-not loaded; }installing the pinned package's agent"
  # Not fatal: ssh-agent-install ends in a launchctl bootstrap, which a session
  # without the GUI domain (ssh) cannot do; said, and the run ends red.
  if (cd "$CONFIG_DIR" && ssh-agent-install); then
    ok "ssh-agent: $SSH_AGENT_LABEL runs the pinned package"
  else
    err "ssh-agent: ssh-agent-install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# The server is the human's switch, never this script's: the package's
# sshd-install turns it on, sshd-uninstall off, and launchd's state is the
# only truth. An update keeps a loaded server on the pinned package the way it
# keeps the agent — when gui/<uid>/org.forkcloser.sshd runs another package,
# the pinned package's sshd-install moves it — and a server that is not loaded
# is off: nothing is run, nothing is suggested. The program is read from
# launchctl's own `program =` line, so the step does not depend on what the
# package names its launchd entry point.
readonly SSHD_LABEL="org.forkcloser.sshd"
refresh_sshd() {
  is_macos || return 0
  local pkg program
  pkg="$(cd "$CONFIG_DIR" && aqua which sshd-install 2>/dev/null)" || return 0
  pkg="${pkg%/bin/sshd-install}"
  program="$({ launchctl print "gui/$(id -u)/$SSHD_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*program = \(/.*\)$#\1#p' | head -n 1)"
  if [ -z "$program" ]; then
    log "sshd: $SSHD_LABEL not loaded; the server is off and stays off"
    return 0
  fi
  case "$program" in
    "$pkg"/*)
      ok "sshd: $SSHD_LABEL runs the pinned package"
      return 0
      ;;
  esac
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "sshd: LIMEN_INSTALL_NO_LAUNCHD is set; $SSHD_LABEL left on $program"
    return 0
  fi
  log "sshd: $SSHD_LABEL runs $program, the pin is $pkg: moving the server onto it"
  if (cd "$CONFIG_DIR" && sshd-install); then
    ok "sshd: $SSHD_LABEL runs the pinned package"
  else
    err "sshd: sshd-install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# taciturn's agent, gui/<uid>/org.forkcloser.taciturn, runs the binary by its
# real path, so an upgrade would leave it on the old package. The first
# install — the bot's key, its policy, the agent loaded — is the human's
# (`taciturn install`), with the key store that comes with it; this script only
# keeps a loaded agent on the pinned package, with the pinned binary's own
# `taciturn install`, which rewrites the plist and bootstraps it again. Not
# loaded means not installed here: nothing is run.
readonly TACITURN_LABEL="org.forkcloser.taciturn"
refresh_taciturn() {
  is_macos || return 0
  local pkg program
  pkg="$(cd "$CONFIG_DIR" && aqua which taciturn 2>/dev/null)" || return 0
  pkg="${pkg%/taciturn}"
  program="$({ launchctl print "gui/$(id -u)/$TACITURN_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*program = \(/.*\)$#\1#p' | head -n 1)"
  if [ -z "$program" ]; then
    log "taciturn: $TACITURN_LABEL not loaded; the first install is yours: taciturn install"
    return 0
  fi
  case "$program" in
    "$pkg"/*)
      ok "taciturn: $TACITURN_LABEL runs the pinned package"
      return 0
      ;;
  esac
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "taciturn: LIMEN_INSTALL_NO_LAUNCHD is set; $TACITURN_LABEL left on $program"
    return 0
  fi
  log "taciturn: $TACITURN_LABEL runs $program, the pin is $pkg: moving the agent onto it"
  if (cd "$CONFIG_DIR" && taciturn install); then
    ok "taciturn: $TACITURN_LABEL runs the pinned package"
  else
    err "taciturn: taciturn install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# Writes the runner and the agent's plist, and (re)loads the agent when the
# plist is new or changed. Not from inside the nightly run itself: a bootout
# there kills the very job that is running, and launchd reads the rewritten
# plist at the next login anyway.
install_nightly() {
  if ! is_macos; then
    log "nightly update job: macOS only for now (launchd); nothing installed"
    return
  fi

  mkdir -p "${NIGHTLY_RUNNER%/*}" "${NIGHTLY_PLIST%/*}" "${NIGHTLY_LOG%/*}"

  # Written beside and moved into place: the nightly run is this very runner,
  # still being read by its shell, and a longer text written over it would be
  # executed from the wrong offset.
  local runner
  runner="$(mktemp "${NIGHTLY_RUNNER%/*}/.nightly.XXXXXX")"
  cat > "$runner" <<RUNNER
#!/bin/sh
# Written by limen-install; overwritten on each run. The nightly job: fetch
# the latest release of limen-install over https and run it. No clone, no
# credential, no key: the trust is TLS to github.com and the ruleset that
# restricts v* tags to the repository's admins.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# The log is launchd's open file: trimmed in place, never replaced.
log="$NIGHTLY_LOG"
if [ -f "\$log" ] && [ "\$(wc -c < "\$log")" -gt 1048576 ]; then
  tail -c 262144 "\$log" > "\$log.trim" && cat "\$log.trim" > "\$log" && rm -f "\$log.trim"
fi
export AQUA_GLOBAL_CONFIG="$AQUA_GLOBAL_CONFIG"
export AQUA_POLICY_CONFIG="$POLICY_FILE"
export LIMEN_INSTALL_NIGHTLY=1
url=\$(curl --proto '=https' --tlsv1.2 -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/farcloser/limen-install/releases/latest)
tag=\${url##*/}
case "\$tag" in
  v*) ;;
  *) echo "limen-install nightly: no release tag behind \$url" >&2; exit 1 ;;
esac
t=\$(mktemp -d "\${TMPDIR:-/tmp}/limen-install.XXXXXX")
trap 'rm -rf "\$t"' EXIT
curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors -o "\$t/limen-install" \
  "https://raw.githubusercontent.com/farcloser/limen-install/\$tag/limen-install"
echo "limen-install nightly: \$(date -u +%Y-%m-%dT%H:%M:%SZ) running \$tag"
bash "\$t/limen-install"
RUNNER
  chmod 755 "$runner"
  mv "$runner" "$NIGHTLY_RUNNER"

  local plist
  plist="$(mktemp "${TMPDIR:-/tmp}/limen-install.plist.XXXXXX")"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$NIGHTLY_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>$NIGHTLY_RUNNER</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$NIGHTLY_HOUR</integer>
    <key>Minute</key>
    <integer>$NIGHTLY_MINUTE</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$NIGHTLY_LOG</string>
  <key>StandardErrorPath</key>
  <string>$NIGHTLY_LOG</string>
</dict>
</plist>
PLIST

  local changed=1
  if [ -f "$NIGHTLY_PLIST" ] && cmp -s "$plist" "$NIGHTLY_PLIST"; then
    changed=0
  fi
  mv "$plist" "$NIGHTLY_PLIST"
  chmod 644 "$NIGHTLY_PLIST"

  local domain
  domain="gui/$(id -u)"
  if [ "${LIMEN_INSTALL_NIGHTLY:-}" = 1 ]; then
    ok "nightly update job: runner refreshed (a changed plist loads at the next login)"
  elif [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "nightly update job: LIMEN_INSTALL_NO_LAUNCHD is set; the plist is written and not loaded"
  elif [ "$changed" = 1 ] || ! launchctl print "$domain/$NIGHTLY_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$domain/$NIGHTLY_LABEL" 2>/dev/null || true
    # Not fatal: the toolchain is installed by now, and a session without the
    # GUI domain (ssh) cannot load a user agent; said, and the run ends red.
    if launchctl bootstrap "$domain" "$NIGHTLY_PLIST"; then
      ok "nightly update job loaded: $NIGHTLY_LABEL at $(printf '%02d:%02d' "$NIGHTLY_HOUR" "$NIGHTLY_MINUTE"), log $NIGHTLY_LOG"
    else
      err "nightly update job not loaded: launchctl bootstrap $domain failed — from a logged-in terminal, run limen-install again"
      LAUNCHD_FAILED=1
    fi
  else
    ok "nightly update job: $NIGHTLY_LABEL loaded, unchanged"
  fi
}

preflight_writes
install_aqua
ensure_shell_config
write_config
install_tools
refresh_ssh_agent
refresh_sshd
refresh_taciturn
install_nightly
if [ "$SHELL_CHANGED" = 1 ]; then
  ok "open a new shell to pick up PATH changes"
fi
if [ "$LAUNCHD_FAILED" = 1 ]; then
  err "done, except a service that could not be loaded (above)"
  exit 1
fi
ok "done"
