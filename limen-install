#!/usr/bin/env bash
#
# limen-install — set up / update a dev machine's toolset: hermetic, the
# toolset's own aqua (forkcloser/hermetic), in a root of its own, and through
# it limen, the project scaffolder, plus on macOS/arm64 the OpenSSH fork and
# taciturn. The pins live in the root, written below — no separate config
# repo, no fetch. (GITHUB_TOKEN is honored when set: API rate limits.)
#
# Per-project setup is separate: `hermetic policy allow && hermetic i -l`
# inside a repo. A shell's own aqua, if it has one, is untouched: nothing of
# the toolset is exported into the shell beyond one PATH entry.

set -euo pipefail

# The root: HERMETIC_ROOT_DIR, or the binary's own default for the platform,
# which is primordium's data directory for the name. Kept in UNEXPANDED form:
# this exact text goes into the shell rc, so the rc keeps tracking $HOME and
# XDG_DATA_HOME at shell startup (and survives dotfile syncs across machines)
# instead of freezing today's absolute paths. The script evaluates it for its
# own use. On Windows (git-bash) the binary roots at %LOCALAPPDATA%, which
# git-bash inherits, so the expression follows the variable wherever it points.
case "$OSTYPE" in
  msys*|cygwin*)
    # shellcheck disable=SC2016
    ROOT_EXPR='${HERMETIC_ROOT_DIR:-${LOCALAPPDATA:-$HOME/AppData/Local}/hermetic}' ;;
  darwin*)
    # shellcheck disable=SC2016
    ROOT_EXPR='${HERMETIC_ROOT_DIR:-$HOME/Library/Application Support/hermetic}' ;;
  *)
    # shellcheck disable=SC2016
    ROOT_EXPR='${HERMETIC_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/hermetic}' ;;
esac
readonly ROOT_EXPR
ROOT="$(eval "echo \"$ROOT_EXPR\"")"
readonly ROOT
# The preset is remembered: when set, the rc and the nightly runner carry the
# actual custom path, since the default expression would point elsewhere.
HERMETIC_ROOT_DIR_PRESET="${HERMETIC_ROOT_DIR:-}"
readonly HERMETIC_ROOT_DIR_PRESET

# Every tool this script runs is the system's, for the whole run. On a machine
# that already has the toolset, cat, mkdir, mktemp, rm, curl and the rest of
# coreutils on PATH may be a project's shims, and a shim parses its config
# before it runs anything: `cat > file <<YAML` truncates the file before cat
# starts. The root's bin comes next, for `hermetic` and, once installed,
# `limen`. The root's bin has a space in it on macOS: quoted wherever it is
# spliced.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:$ROOT/bin:$PATH"
export PATH

# The version is Renovate-managed (see renovate.json); the sha256 is of the
# release's checksums.txt, which must change with it, recomputed on Renovate's
# branches by update-installer-checksum.yaml — the pair always moves together.
# One digest covers every platform: the asset is verified against
# checksums.txt, and checksums.txt against this.
# renovate: depName=forkcloser/hermetic
readonly HERMETIC_VERSION="v0.2.3"
readonly HERMETIC_CHECKSUMS_SHA256="c7eb09712dc3d756bead96ae1286b53de275134d0012601ef37f57ec793f9431"

SHELL_CHANGED=0   # set to 1 if we modify the shell rc (→ advise opening a new shell)

# The nightly update job, macOS only for now: a launchd agent that fetches the
# latest release of this script over https and runs it. The runner lives under
# XDG data, the agent's plist and log where launchd and Console look. Under
# launchd the rc is never sourced, so the runner exports a preset root itself,
# and LIMEN_INSTALL_NIGHTLY tells this script it is that run.
readonly NIGHTLY_LABEL="world.farcloser.limen-install"
readonly NIGHTLY_HOUR=4 NIGHTLY_MINUTE=17
NIGHTLY_RUNNER="${XDG_DATA_HOME:-$HOME/.local/share}/limen-install/nightly"
readonly NIGHTLY_RUNNER
readonly NIGHTLY_PLIST="$HOME/Library/LaunchAgents/$NIGHTLY_LABEL.plist"
readonly NIGHTLY_LOG="$HOME/Library/Logs/limen-install.log"
LAUNCHD_FAILED=0  # set to 1 when a service could not be loaded (→ exit 1 at the end)
is_macos() { [ "$(uname -s)" = Darwin ]; }
is_windows() { case "$OSTYPE" in msys*|cygwin*) return 0 ;; *) return 1 ;; esac; }

log() { printf '› %s\n' "$*"; }
ok()  { printf '✓ %s\n' "$*"; }
err() { printf '✗ %s\n' "$*" >&2; }

verify_sha256() {  # $1=file $2=expected
  # No single digest tool exists everywhere: linux and windows git-bash ship
  # coreutils sha256sum, macOS ships perl shasum.
  if command -v sha256sum >/dev/null 2>&1; then
    echo "$2  $1" | sha256sum -c - >/dev/null 2>&1 \
      || { err "checksum mismatch: ${1##*/}"; exit 1; }
  else
    echo "$2  $1" | shasum -a 256 -c - >/dev/null 2>&1 \
      || { err "checksum mismatch: ${1##*/}"; exit 1; }
  fi
}

# The release asset for this machine: hermetic_<version>_<os>_<arch>.tar.gz.
# LIMEN_INSTALL_ARCH is the truth when set: limen-install.ps1 reads the
# machine's architecture from the registry, since git-bash on arm64 Windows
# runs emulated and `uname -m` says x86_64 there.
hermetic_asset() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    MINGW*|MSYS*|CYGWIN*) os=windows ;;
    *) err "unsupported system: $(uname -s)"; exit 1 ;;
  esac
  case "${LIMEN_INSTALL_ARCH:-$(uname -m)}" in
    arm64|aarch64|ARM64) arch=arm64 ;;
    x86_64|amd64|AMD64) arch=amd64 ;;
    *) err "unsupported architecture: ${LIMEN_INSTALL_ARCH:-$(uname -m)}"; exit 1 ;;
  esac
  echo "hermetic_${HERMETIC_VERSION#v}_${os}_${arch}.tar.gz"
}

hermetic_bin() {
  if is_windows; then echo "$ROOT/bin/hermetic.exe"; else echo "$ROOT/bin/hermetic"; fi
}

# The binary, at the pinned version, under the pinned checksums.txt: a re-run
# moves an installed one to the pin — without this the version would stay
# frozen at whatever the machine got first (this script is the update path
# too). GitHub's build provenance is verified as well where gh is installed
# and signed in; the checksum chain is the guard everywhere.
install_hermetic() {
  local bin asset
  bin="$(hermetic_bin)"
  asset="$(hermetic_asset)"
  if [ -x "$bin" ] && [ "$("$bin" version 2>/dev/null || true)" = "${HERMETIC_VERSION#v}" ]; then
    ok "hermetic ${HERMETIC_VERSION}"
    return
  fi
  log "installing hermetic ${HERMETIC_VERSION} (${asset})"
  local t; t="$(mktemp -d "${TMPDIR:-/tmp}/limen-install.XXXXXX")"
  local base="https://github.com/forkcloser/hermetic/releases/download/${HERMETIC_VERSION}"
  curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors \
    -o "$t/checksums.txt" "$base/checksums.txt"
  verify_sha256 "$t/checksums.txt" "$HERMETIC_CHECKSUMS_SHA256"
  curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors \
    -o "$t/$asset" "$base/$asset"
  local expected
  expected="$(awk -v a="$asset" '$2 == a {print $1}' "$t/checksums.txt")"
  [ -n "$expected" ] || { err "checksums.txt of hermetic ${HERMETIC_VERSION} does not list $asset"; exit 1; }
  verify_sha256 "$t/$asset" "$expected"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh attestation verify "$t/$asset" --repo forkcloser/hermetic >/dev/null 2>&1 \
      || { err "GitHub attestation of $asset does not verify (gh attestation verify)"; exit 1; }
    ok "hermetic ${HERMETIC_VERSION}: checksum and attestation verified"
  else
    ok "hermetic ${HERMETIC_VERSION}: checksum verified (gh not signed in: no attestation check)"
  fi
  tar -xzf "$t/$asset" -C "$t" "${bin##*/}"
  mkdir -p "$ROOT/bin"
  # Replaced by renaming the old one aside and moving the new in: a symlink
  # to the name survives; a hard link (Windows) and a running dispatch hold
  # the old file, so it is set aside, not overwritten, and the install below
  # recreates every link whose identity moved. The old file goes when nothing
  # holds it any more.
  if [ -e "$bin" ]; then
    mv -f "$bin" "$bin.old"
  fi
  mv -f "$t/${bin##*/}" "$bin"
  chmod 755 "$bin"
  rm -f "$bin.old" 2>/dev/null || true
  rm -rf "$t"
  ok "hermetic ${HERMETIC_VERSION} installed: $bin"
}

shell_rc() {
  case "${SHELL:-}" in
    */zsh|zsh)  echo "$HOME/.zshrc" ;;
    */bash|bash) echo "$HOME/.bashrc" ;;
    *)    echo "$HOME/.profile" ;;
  esac
}

# Every directory this script writes under, probed with a real file before the
# first step, so an unwritable target (a sandboxed job, a read-only home, a
# config directory owned by someone else) stops the run before it has installed
# or appended anything. A permission test is not enough: a sandbox denies the
# open, not the mode bits.
preflight_writes() {
  local rc p dir probe
  rc="$(shell_rc)"
  set -- "$ROOT/bin" "${rc%/*}"
  if is_macos; then
    set -- "$@" "${NIGHTLY_RUNNER%/*}" "${NIGHTLY_PLIST%/*}" "${NIGHTLY_LOG%/*}"
  fi
  for p in "$@"; do
    dir="$p"
    while [ -n "$dir" ] && [ ! -d "$dir" ]; do dir="${dir%/*}"; done
    : "${dir:=/}"
    if ! probe="$(mktemp "$dir/.limen-install.XXXXXX" 2>/dev/null)"; then
      err "cannot write under $dir"
      exit 1
    fi
    rm -f "$probe"
  done
}

# One rc line: the root's bin on PATH. Default root → the unexpanded
# expression (the rc stays $HOME/XDG relative); preset HERMETIC_ROOT_DIR →
# the actual custom path. Appended last, so it comes first on PATH, ahead of
# an aqua bin a previous installer put there.
ensure_shell_config() {
  local rc path_value
  rc="$(shell_rc)"
  path_value="$ROOT_EXPR/bin"
  if [ -n "$HERMETIC_ROOT_DIR_PRESET" ]; then
    path_value="$HERMETIC_ROOT_DIR_PRESET/bin"
  fi
  # Guard with the exact literal we write (grep -F): a looser hand-written
  # pattern silently never matches and the line gets re-appended on every run.
  if ! grep -qF "$path_value" "$rc" 2>/dev/null; then
    # shellcheck disable=SC2016
    printf '\n# hermetic\nexport PATH="%s:$PATH"\n' "$path_value" >> "$rc"
    SHELL_CHANGED=1
  fi
  # The previous installer's three lines are the human's to remove (the
  # migration list in forkcloser/hermetic's docs/design.md); said once.
  if grep -qE 'aquaproj-aqua}?/bin|AQUA_GLOBAL_CONFIG=|AQUA_POLICY_CONFIG=' "$rc" 2>/dev/null; then
    log "$rc still carries the previous installer's aqua lines (the # aqua PATH entry, AQUA_GLOBAL_CONFIG, AQUA_POLICY_CONFIG): remove them; the toolset no longer reads them"
  fi
}

# Renovate bumps the pins below, grouped with aqua.yaml's — do not hand-edit
# them out of step.
write_config() {
  mkdir -p "$ROOT"

  cat > "$ROOT/hermetic.yaml" <<'YAML'
---
# The toolset's pins: limen, the project scaffolder, gh, which limen's github
# subcommands run, OpenSSH with security keys built in, and taciturn, the
# Secure Enclave ssh-agent. hermetic's global config, read from its root.
# Written by limen-install; edits are overwritten on the next run.
checksum:
  enabled: true
  require_checksum: true
registries:
  - name: farcloser
    type: local
    path: registry.yaml
packages:
  - name: farcloser/limen@v0.16.0 # renovate: depName=farcloser/limen
    registry: farcloser
  - name: cli/cli@v2.103.3 # renovate: depName=cli/cli
    registry: farcloser
  - name: forkcloser/openssh@v10.6.1.3 # renovate: depName=forkcloser/openssh
    registry: farcloser
  - name: forkcloser/taciturn@v0.3.0 # renovate: depName=forkcloser/taciturn
    registry: farcloser
YAML

  # The registry entry mirrors what goreleaser publishes: per-platform tar.gz
  # archives named limen_<version>_<os>_<arch>.tar.gz plus a checksums.txt that
  # the checksums are pinned from (see update-checksum below).
  cat > "$ROOT/registry.yaml" <<'YAML'
---
# Written by limen-install; edits are overwritten on the next run.
packages:
  - type: github_release
    repo_owner: farcloser
    repo_name: limen
    description: Verify a repository against Farcloser engineering rules
    asset: limen_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: limen
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
      # Signature doctrine: verify whenever upstream publishes. The release
      # signs checksums.txt keyless from CI; the identity is the release
      # workflow at the exact tag, so a bundle signed by anything else fails.
      cosign:
        bundle:
          type: github_release
          asset: checksums.txt.sigstore.json
        opts:
          - --certificate-identity
          - https://github.com/farcloser/limen/.github/workflows/release.yaml@refs/tags/{{.Version}}
          - --certificate-oidc-issuer
          - https://token.actions.githubusercontent.com
    supported_envs:
      - darwin
      - linux
      - windows
  # gh, which limen's github subcommands and bootstrap's update-App steps run
  # from wherever limen is invoked: inside a project the project's own pin
  # answers, everywhere else this one. The entry is the aqua registry's
  # current block for cli/cli: zip archives, with macOS in the darwin name
  # and tar.gz on linux, the binary under a versioned directory and gh.exe at
  # the archive root on windows; the release ships gh_<version>_checksums.txt
  # and attests every asset from its deployment workflow.
  - type: github_release
    repo_owner: cli
    repo_name: cli
    description: GitHub's official command line tool
    asset: gh_{{trimV .Version}}_{{.OS}}_{{.Arch}}.{{.Format}}
    format: zip
    files:
      - name: gh
        src: gh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/gh
    overrides:
      - goos: linux
        format: tar.gz
      - goos: windows
        files:
          - name: gh
            src: bin/gh.exe
    replacements:
      darwin: macOS
    checksum:
      type: github_release
      asset: gh_{{trimV .Version}}_checksums.txt
      algorithm: sha256
    github_artifact_attestations:
      signer_workflow: cli/cli/.github/workflows/deployment.yml
    supported_envs:
      - darwin
      - linux
      - windows
  # OpenSSH with security keys built in, relocatable, darwin/arm64 only: the
  # package is skipped elsewhere. The entry is the one forkcloser/openssh's
  # README carries; the release attests every asset and ships checksums.txt.
  - type: github_release
    repo_owner: forkcloser
    repo_name: openssh
    description: OpenSSH with security keys built in, relocatable, darwin/arm64 (forkcloser/openssh)
    asset: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: ssh
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh
      - name: ssh-agent
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-agent
      - name: ssh-add
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-add
      - name: ssh-keygen
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-keygen
      - name: ssh-keyscan
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-keyscan
      - name: scp
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/scp
      - name: sftp
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sftp
      - name: ssh-agent-install
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/ssh-agent-install
      - name: sshd-install
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sshd-install
      - name: sshd-uninstall
        src: openssh_{{trimV .Version}}_{{.OS}}_{{.Arch}}/bin/sshd-uninstall
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
    github_artifact_attestations:
      signer_workflow: forkcloser/openssh/.github/workflows/release.yaml
    supported_envs:
      - darwin/arm64
  # taciturn, the ssh-agent for Secure Enclave keys the sessions sign and push
  # through, darwin/arm64 only. From v0.2.0 the archive carries Taciturn.app
  # and nothing else: the kernel refuses the binary's keychain entitlements
  # outside its signed bundle, so the binary lives inside it, and the agent
  # itself resolves that path when it installs its LaunchAgent. The v0.1
  # archives had the binary at the root. The release attests the asset and
  # ships checksums.txt.
  - type: github_release
    repo_owner: forkcloser
    repo_name: taciturn
    description: ssh-agent for Secure Enclave keys, with per-key policy (forkcloser/taciturn)
    asset: taciturn_{{trimV .Version}}_{{.OS}}_{{.Arch}}.tar.gz
    format: tar.gz
    files:
      - name: taciturn
        src: Taciturn.app/Contents/MacOS/taciturn
    # version_overrides is consulted only when the entry itself carries a
    # version_constraint; without this line every version takes the files above.
    version_constraint: semver(">= 0.2.0")
    version_overrides:
      - version_constraint: semver("< 0.2.0")
        files:
          - name: taciturn
    checksum:
      type: github_release
      asset: checksums.txt
      algorithm: sha256
    github_artifact_attestations:
      signer_workflow: forkcloser/taciturn/.github/workflows/release.yaml
    supported_envs:
      - darwin/arm64
YAML

  cat > "$ROOT/policy.yaml" <<'YAML'
---
# Written by limen-install; edits are overwritten on the next run.
registries:
  - name: farcloser
    type: local
    path: registry.yaml
packages:
  - registry: farcloser
YAML

  ok "toolset pins written: ${ROOT} (hermetic.yaml, registry.yaml, policy.yaml)"
}

# The toolset into the root's store, and the links into the root's bin. The
# config is named outright with -c: hermetic's own walk looks for a project's
# .hermetic/hermetic.yaml, never for this file, and update-checksum without
# a named config writes nothing. --log-level warn: the install lines are
# noise on a nightly log; a failure is still printed and ends the run.
install_tools() {
  local h; h="$(hermetic_bin)"
  "$h" --log-level warn -c "$ROOT/hermetic.yaml" update-checksum --prune
  "$h" --log-level warn -c "$ROOT/hermetic.yaml" install -a
  ok "scaffolder ready: $(limen version 2>/dev/null || echo 'open a new shell, then run: limen version')"
}

# Where a toolset package lives, for the launchd steps below: hermetic
# resolves the name from the root's pins wherever it runs.
toolset_which() { "$(hermetic_bin)" which "$1" 2>/dev/null; }

# The ssh-agent launchd agent runs the package by its real path (launchd has
# no shim to resolve), so an upgrade would leave it on the old binary, whose
# sk-helper then fails every signature. On macOS the agent is part of the
# toolset: when the loaded agent is not the pinned package — none loaded, an
# older one, a hand-unpacked one — the package's ssh-agent-install boots the
# label out, writes the plist to its own path and bootstraps it. Only a test
# holds back: the smoke installs into a throwaway HOME that shares the
# machine's launchd domain, and it says so with LIMEN_INSTALL_NO_LAUNCHD,
# which keeps every service, this one and the nightly job, unloaded.
readonly SSH_AGENT_LABEL="org.forkcloser.ssh_agent"
refresh_ssh_agent() {
  is_macos || return 0
  local pkg running
  pkg="$(toolset_which ssh-agent-install)" || return 0
  pkg="${pkg%/bin/ssh-agent-install}"
  # launchctl exits 113 for a label it does not know, which pipefail would
  # turn into this function's exit: an unloaded agent is a case, not an error.
  running="$({ launchctl print "gui/$(id -u)/$SSH_AGENT_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*\(/.*\)/libexec/ssh-agent-launchd$#\1#p' | head -n 1)"
  if [ "$running" = "$pkg" ]; then
    ok "ssh-agent: $SSH_AGENT_LABEL runs the pinned package"
    return 0
  fi
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "ssh-agent: LIMEN_INSTALL_NO_LAUNCHD is set; $SSH_AGENT_LABEL left as it is (${running:-not loaded})"
    return 0
  fi
  log "ssh-agent: $SSH_AGENT_LABEL ${running:+runs $running, }${running:-not loaded; }installing the pinned package's agent"
  # Not fatal: ssh-agent-install ends in a launchctl bootstrap, which a session
  # without the GUI domain (ssh) cannot do; said, and the run ends red.
  if ssh-agent-install; then
    ok "ssh-agent: $SSH_AGENT_LABEL runs the pinned package"
  else
    err "ssh-agent: ssh-agent-install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# The server is the human's switch, never this script's: the package's
# sshd-install turns it on, sshd-uninstall off, and launchd's state is the
# only truth. An update keeps a loaded server on the pinned package the way it
# keeps the agent — when gui/<uid>/org.forkcloser.sshd runs another package,
# the pinned package's sshd-install moves it — and a server that is not loaded
# is off: nothing is run, nothing is suggested. The program is read from
# launchctl's own `program =` line, so the step does not depend on what the
# package names its launchd entry point.
readonly SSHD_LABEL="org.forkcloser.sshd"
refresh_sshd() {
  is_macos || return 0
  local pkg program
  pkg="$(toolset_which sshd-install)" || return 0
  pkg="${pkg%/bin/sshd-install}"
  program="$({ launchctl print "gui/$(id -u)/$SSHD_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*program = \(/.*\)$#\1#p' | head -n 1)"
  if [ -z "$program" ]; then
    log "sshd: $SSHD_LABEL not loaded; the server is off and stays off"
    return 0
  fi
  case "$program" in
    "$pkg"/*)
      ok "sshd: $SSHD_LABEL runs the pinned package"
      return 0
      ;;
  esac
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "sshd: LIMEN_INSTALL_NO_LAUNCHD is set; $SSHD_LABEL left on $program"
    return 0
  fi
  log "sshd: $SSHD_LABEL runs $program, the pin is $pkg: moving the server onto it"
  if sshd-install; then
    ok "sshd: $SSHD_LABEL runs the pinned package"
  else
    err "sshd: sshd-install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# taciturn's agent, gui/<uid>/org.forkcloser.taciturn, runs the binary by its
# real path, so an upgrade would leave it on the old package. The first
# install — the bot's key, its policy, the agent loaded — is the human's
# (`taciturn install`), with the key store that comes with it; this script only
# keeps a loaded agent on the pinned package, with the pinned binary's own
# `taciturn install`, which rewrites the plist and bootstraps it again. Not
# loaded means not installed here: nothing is run.
readonly TACITURN_LABEL="org.forkcloser.taciturn"
refresh_taciturn() {
  is_macos || return 0
  local pkg program
  pkg="$(toolset_which taciturn)" || return 0
  pkg="${pkg%/taciturn}"
  program="$({ launchctl print "gui/$(id -u)/$TACITURN_LABEL" 2>/dev/null || true; } | sed -n 's#^[[:space:]]*program = \(/.*\)$#\1#p' | head -n 1)"
  if [ -z "$program" ]; then
    log "taciturn: $TACITURN_LABEL not loaded; the first install is yours: taciturn install"
    return 0
  fi
  case "$program" in
    "$pkg"/*)
      ok "taciturn: $TACITURN_LABEL runs the pinned package"
      return 0
      ;;
  esac
  if [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "taciturn: LIMEN_INSTALL_NO_LAUNCHD is set; $TACITURN_LABEL left on $program"
    return 0
  fi
  log "taciturn: $TACITURN_LABEL runs $program, the pin is $pkg: moving the agent onto it"
  if taciturn install; then
    ok "taciturn: $TACITURN_LABEL runs the pinned package"
  else
    err "taciturn: taciturn install failed — from a logged-in terminal, run limen-install again"
    LAUNCHD_FAILED=1
  fi
}

# Writes the runner and the agent's plist, and (re)loads the agent when the
# plist is new or changed. Not from inside the nightly run itself: a bootout
# there kills the very job that is running, and launchd reads the rewritten
# plist at the next login anyway.
install_nightly() {
  if ! is_macos; then
    log "nightly update job: macOS only for now (launchd); nothing installed"
    return
  fi

  mkdir -p "${NIGHTLY_RUNNER%/*}" "${NIGHTLY_PLIST%/*}" "${NIGHTLY_LOG%/*}"

  # A preset root travels into the runner, since launchd sources no rc; the
  # default root is the binary's own and needs no variable.
  local root_export=""
  if [ -n "$HERMETIC_ROOT_DIR_PRESET" ]; then
    root_export="export HERMETIC_ROOT_DIR=\"$HERMETIC_ROOT_DIR_PRESET\""
  fi

  # Written beside and moved into place: the nightly run is this very runner,
  # still being read by its shell, and a longer text written over it would be
  # executed from the wrong offset.
  local runner
  runner="$(mktemp "${NIGHTLY_RUNNER%/*}/.nightly.XXXXXX")"
  cat > "$runner" <<RUNNER
#!/bin/sh
# Written by limen-install; overwritten on each run. The nightly job: fetch
# the latest release of limen-install over https and run it. No clone, no
# credential, no key: the trust is TLS to github.com and the ruleset that
# restricts v* tags to the repository's admins.
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
# The log is launchd's open file: trimmed in place, never replaced.
log="$NIGHTLY_LOG"
if [ -f "\$log" ] && [ "\$(wc -c < "\$log")" -gt 1048576 ]; then
  tail -c 262144 "\$log" > "\$log.trim" && cat "\$log.trim" > "\$log" && rm -f "\$log.trim"
fi
$root_export
export LIMEN_INSTALL_NIGHTLY=1
url=\$(curl --proto '=https' --tlsv1.2 -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/farcloser/limen-install/releases/latest)
tag=\${url##*/}
case "\$tag" in
  v*) ;;
  *) echo "limen-install nightly: no release tag behind \$url" >&2; exit 1 ;;
esac
t=\$(mktemp -d "\${TMPDIR:-/tmp}/limen-install.XXXXXX")
trap 'rm -rf "\$t"' EXIT
curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors -o "\$t/limen-install" \
  "https://raw.githubusercontent.com/farcloser/limen-install/\$tag/limen-install"
echo "limen-install nightly: \$(date -u +%Y-%m-%dT%H:%M:%SZ) running \$tag"
bash "\$t/limen-install"
RUNNER
  chmod 755 "$runner"
  mv "$runner" "$NIGHTLY_RUNNER"

  local plist
  plist="$(mktemp "${TMPDIR:-/tmp}/limen-install.plist.XXXXXX")"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$NIGHTLY_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>$NIGHTLY_RUNNER</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$NIGHTLY_HOUR</integer>
    <key>Minute</key>
    <integer>$NIGHTLY_MINUTE</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$NIGHTLY_LOG</string>
  <key>StandardErrorPath</key>
  <string>$NIGHTLY_LOG</string>
</dict>
</plist>
PLIST

  local changed=1
  if [ -f "$NIGHTLY_PLIST" ] && cmp -s "$plist" "$NIGHTLY_PLIST"; then
    changed=0
  fi
  mv "$plist" "$NIGHTLY_PLIST"
  chmod 644 "$NIGHTLY_PLIST"

  local domain
  domain="gui/$(id -u)"
  if [ "${LIMEN_INSTALL_NIGHTLY:-}" = 1 ]; then
    ok "nightly update job: runner refreshed (a changed plist loads at the next login)"
  elif [ "${LIMEN_INSTALL_NO_LAUNCHD:-}" = 1 ]; then
    log "nightly update job: LIMEN_INSTALL_NO_LAUNCHD is set; the plist is written and not loaded"
  elif [ "$changed" = 1 ] || ! launchctl print "$domain/$NIGHTLY_LABEL" >/dev/null 2>&1; then
    launchctl bootout "$domain/$NIGHTLY_LABEL" 2>/dev/null || true
    # Not fatal: the toolchain is installed by now, and a session without the
    # GUI domain (ssh) cannot load a user agent; said, and the run ends red.
    if launchctl bootstrap "$domain" "$NIGHTLY_PLIST"; then
      ok "nightly update job loaded: $NIGHTLY_LABEL at $(printf '%02d:%02d' "$NIGHTLY_HOUR" "$NIGHTLY_MINUTE"), log $NIGHTLY_LOG"
    else
      err "nightly update job not loaded: launchctl bootstrap $domain failed — from a logged-in terminal, run limen-install again"
      LAUNCHD_FAILED=1
    fi
  else
    ok "nightly update job: $NIGHTLY_LABEL loaded, unchanged"
  fi
}

preflight_writes
install_hermetic
ensure_shell_config
write_config
install_tools
refresh_ssh_agent
refresh_sshd
refresh_taciturn
install_nightly
if [ "$SHELL_CHANGED" = 1 ]; then
  ok "open a new shell to pick up PATH changes"
fi
if [ "$LAUNCHD_FAILED" = 1 ]; then
  err "done, except a service that could not be loaded (above)"
  exit 1
fi
ok "done"
