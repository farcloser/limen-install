#!/usr/bin/env bash
#
# limen-install-agent — let a Claude Code session commit and push as a
# dedicated bot identity: signed commits, over ssh, from inside its sandbox.
# Design and reasoning: limen's book/agents.md.
#
# One trap this file works around: the Claude Code sandbox rewrites
# SSH_AUTH_SOCK to a launchd socket it then denies, even when settings.json's
# env block sets it (the rest of that block arrives intact). So the agent's
# socket travels inside what git execs — `-o IdentityAgent` in core.sshCommand
# for ssh, a one-line ssh-keygen wrapper for signing (git execs gpg.ssh.program
# directly; there is no shell in between to prefix an env) — and nothing here
# depends on the environment variable reaching the session.
#
# Usage:
#   limen-install-agent [--write DIR]... [--socket PATH] [--agent-root DIR]
#                       [--no-verify] <login> <email> <public-key-file>
#
# The sessions' tool root (--agent-root, default ~/.local/share/limen-agent): aqua's
# root, a home for the verifiers, the Go, cargo and XDG caches. A session may write
# it, its own project directory (the sandbox always allows the working directory),
# and any --write directory given, exactly as given; nothing else of the human's.
# the human's own tool roots leave the sandbox's write list. The root gets aqua and
# nothing per repository: sessions approve policies and install pins themselves.
# Design: limen's book/identity.md, "The bot's sandbox".
#
# <public-key-file> is the bot's public key as the agent prints it (taciturn:
# `taciturn key list --format ssh`), registered on <login> BOTH as an
# authentication key and as a signing key. The agent is taciturn's, on its
# socket under ~/Library/Application Support/taciturn; --socket names another
# (a machine still on Secretive's).
#
# Idempotent: re-run to converge after any change. macOS only (the Secure Enclave).

set -euo pipefail

log() { printf '› %s\n' "$*"; }
ok()  { printf '✓ %s\n' "$*"; }
err() { printf '✗ %s\n' "$*" >&2; }

AGENT_SOCKET="$HOME/Library/Application Support/taciturn/agent.sock"
VERIFY=1
AGENT_ROOT="$HOME/.local/share/limen-agent"
WRITE=()
while [ $# -gt 0 ]; do
  case "$1" in
    --socket) AGENT_SOCKET="$2"; shift 2 ;;
    --agent-root) AGENT_ROOT="$2"; shift 2 ;;
    --write) WRITE+=("${2%/}"); shift 2 ;;
    --no-verify) VERIFY=0; shift ;;
    --) shift; break ;;
    -*) err "unknown option: $1"; exit 2 ;;
    *) break ;;
  esac
done
if [ $# -ne 3 ]; then
  err "usage: limen-install-agent [--write DIR]... [--socket PATH] [--agent-root DIR] [--no-verify] <login> <email> <public-key-file>"
  exit 2
fi
for d in ${WRITE[@]+"${WRITE[@]}"}; do [ -d "$d" ] || { err "--write $d: not a directory"; exit 2; }; done
readonly BOT_LOGIN="$1" BOT_EMAIL="$2" BOT_KEY_FILE="$3"
BOT_KEY="$(head -n 1 "$BOT_KEY_FILE")"
readonly BOT_KEY
case "$BOT_KEY" in
  ecdsa-sha2-nistp256\ *|ssh-ed25519\ *|sk-*\ *) ;;
  *) err "$BOT_KEY_FILE does not look like an OpenSSH public key"; exit 2 ;;
esac

[ "$(uname -s)" = Darwin ] || { err "macOS only: the bot key lives in the Secure Enclave"; exit 1; }
for tool in python3 curl aqua; do
  command -v "$tool" >/dev/null 2>&1 || { err "$tool is required (the ProxyCommand helper and the settings merge are python3; curl fetches GitHub's host keys; aqua populates the sessions' tool root)"; exit 1; }
done
readonly AGENT_ROOT WRITE

# Claude Code's configuration home; CLAUDE_CONFIG_DIR is its own override.
readonly CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
readonly HELPER="$CLAUDE_HOME/bin/ssh-connect-proxy"
readonly SIGNER="$CLAUDE_HOME/bin/ssh-keygen-agent"
readonly KNOWN_HOSTS="$CLAUDE_HOME/known_hosts"
readonly SETTINGS="$CLAUDE_HOME/settings.json"
readonly AGENT_AQUA="$AGENT_ROOT/aqua" AGENT_HOME="$AGENT_ROOT/home"

install_helper() {
  mkdir -p "$CLAUDE_HOME/bin"
  cat > "$HELPER" <<'PY'
#!/usr/bin/env python3
"""ssh ProxyCommand for the Claude Code sandbox: an authenticated HTTP CONNECT tunnel.

The sandbox routes every outbound connection through a per-session proxy that
requires credentials. It hands them to HTTP clients via HTTPS_PROXY, but the
ssh ProxyCommand it configures (a bare `nc -X 5`) offers none, so ssh is
refused. This helper speaks CONNECT with those credentials, then relays bytes
between ssh and the tunnel. Installed by limen-install-agent; the proxy's port
and credentials are read from the environment at run time.

usage (as ssh sees it): ssh-connect-proxy %h %p
"""
import base64
import os
import select
import socket
import sys
from urllib.parse import unquote, urlsplit


def proxy_from_env():
    for name in ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy", "HTTP_PROXY", "http_proxy"):
        value = os.environ.get(name)
        if value:
            parts = urlsplit(value)
            if parts.hostname and parts.port:
                return parts
    sys.exit("ssh-connect-proxy: no HTTP proxy in the environment (not inside the Claude Code sandbox?)")


def relay(sock, out):
    fin = sys.stdin.buffer.fileno()
    while True:
        readable, _, _ = select.select([sock, fin], [], [])
        if sock in readable:
            data = sock.recv(65536)
            if not data:
                return
            out.write(data)
            out.flush()
        if fin in readable:
            data = os.read(fin, 65536)
            if not data:
                sock.shutdown(socket.SHUT_WR)
                while True:
                    tail = sock.recv(65536)
                    if not tail:
                        return
                    out.write(tail)
                    out.flush()
            sock.sendall(data)


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: ssh-connect-proxy host port")
    host, port = sys.argv[1], sys.argv[2]
    proxy = proxy_from_env()
    sock = socket.create_connection((proxy.hostname, proxy.port))
    request = f"CONNECT {host}:{port} HTTP/1.1\r\nHost: {host}:{port}\r\n"
    if proxy.username:
        credentials = f"{unquote(proxy.username)}:{unquote(proxy.password or '')}".encode()
        request += "Proxy-Authorization: Basic " + base64.b64encode(credentials).decode() + "\r\n"
    sock.sendall((request + "\r\n").encode())
    buffer = b""
    while b"\r\n\r\n" not in buffer:
        chunk = sock.recv(4096)
        if not chunk:
            sys.exit("ssh-connect-proxy: proxy closed the connection during CONNECT")
        buffer += chunk
    head, rest = buffer.split(b"\r\n\r\n", 1)
    status = head.split(b"\r\n", 1)[0].decode(errors="replace")
    if " 200" not in status:
        sys.exit(f"ssh-connect-proxy: CONNECT {host}:{port} refused: {status}")
    out = sys.stdout.buffer
    if rest:
        out.write(rest)
        out.flush()
    relay(sock, out)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, ConnectionResetError):
        pass
PY
  chmod 0755 "$HELPER"
  ok "ProxyCommand helper: $HELPER"

  # ssh-keygen -Y sign reaches the agent only through SSH_AUTH_SOCK, and git
  # execs gpg.ssh.program directly — so the socket is pinned in a wrapper.
  cat > "$SIGNER" <<SH
#!/bin/sh
# Written by limen-install-agent: Apple's ssh-keygen (the Homebrew one has no
# OpenSSL, hence no ECDSA) with the agent socket pinned, because the Claude
# Code sandbox rewrites SSH_AUTH_SOCK to a socket it then denies.
SSH_AUTH_SOCK='$AGENT_SOCKET'
export SSH_AUTH_SOCK
exec /usr/bin/ssh-keygen "\$@"
SH
  chmod 0755 "$SIGNER"
  ok "signing wrapper: $SIGNER"
}

pin_github_host_keys() {
  # GitHub publishes its host keys at api.github.com/meta; pinned here so the
  # sandbox (denied ~/.ssh) verifies the host strictly, never trust-on-first-use.
  local meta
  meta="$(curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors https://api.github.com/meta)"
  {
    echo "# GitHub's ssh host keys, from https://api.github.com/meta — written by limen-install-agent."
    echo "# Compare against https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints"
    printf '%s' "$meta" | python3 -c 'import json,sys; [print("github.com", k) for k in json.load(sys.stdin)["ssh_keys"]]'
  } > "$KNOWN_HOSTS"
  chmod 0644 "$KNOWN_HOSTS"
  ok "GitHub host keys pinned: $KNOWN_HOSTS ($(grep -c '^github.com ' "$KNOWN_HOSTS") keys)"
}

# aqua goes into the root here, outside any sandbox, with HOME pointed into it so
# the verifiers' TUF cache lands there too (slsa-verifier reads no other variable);
# the same aqua version the machine runs. Nothing per repository: a session
# approves a checkout's policy and installs its pins itself, into this root.
install_agent_root() {
  mkdir -p "$AGENT_AQUA" "$AGENT_HOME" "$AGENT_ROOT/go" "$AGENT_ROOT/go-build" "$AGENT_ROOT/cargo" "$AGENT_ROOT/cache"
  local version
  version="v$(aqua -v | awk '{print $3}')"
  HOME="$AGENT_HOME" AQUA_ROOT_DIR="$AGENT_AQUA" aqua update-aqua "$version" >/dev/null
  ok "sessions' tool root: $AGENT_ROOT (aqua $version)"
}

merge_settings() {
  mkdir -p "$CLAUDE_HOME"
  [ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
  cp "$SETTINGS" "$SETTINGS.bak"
  local ssh_command
  # IdentityAgent pins the enclave agent whatever SSH_AUTH_SOCK says (the
  # sandbox rewrites it); IdentitiesOnly=no lets the agent's key be offered.
  ssh_command="/usr/bin/ssh -o IdentityAgent='$AGENT_SOCKET' -o IdentitiesOnly=no -o ProxyCommand='python3 $HELPER %h %p' -o UserKnownHostsFile=$KNOWN_HOSTS -o StrictHostKeyChecking=yes -o ControlMaster=no -o ControlPath=none"
  SOCKET="$AGENT_SOCKET" LOGIN="$BOT_LOGIN" EMAIL="$BOT_EMAIL" KEY="$BOT_KEY" SSHCMD="$ssh_command" SIGNER_PATH="$SIGNER" \
  ROOT="$AGENT_ROOT" WRITE_DIRS="$(printf '%s\n' ${WRITE[@]+"${WRITE[@]}"})" USER_HOME="$HOME" \
  python3 - "$SETTINGS" <<'PY'
import json, os, sys
path = sys.argv[1]
with open(path) as f:
    settings = json.load(f)
env = settings.setdefault("env", {})
# Drop the stale numbered block, and the socket beside it, before writing them
# again in one fixed order: the file then converges on the first run, not the
# second (a key left in place while its neighbours are re-added moves).
for key in [k for k in env if k.startswith("GIT_CONFIG_") or k == "SSH_AUTH_SOCK"]:
    del env[key]
entries = [
    ("user.name", os.environ["LOGIN"]),
    ("user.email", os.environ["EMAIL"]),
    ("user.signingkey", "key::" + os.environ["KEY"]),
    # The wrapper around Apple's ssh-keygen (the Homebrew OpenSSH is built
    # without OpenSSL and cannot use an ECDSA key) with the agent socket
    # pinned inside it — see the header on SSH_AUTH_SOCK.
    ("gpg.ssh.program", os.environ["SIGNER_PATH"]),
    ("core.sshCommand", os.environ["SSHCMD"]),
    # `git c push|fetch|pull`: the sandbox exports GIT_SSH_COMMAND, which
    # outranks core.sshCommand; this alias drops it for one command.
    ("alias.c", "!env -u GIT_SSH_COMMAND git"),
]
env["GIT_CONFIG_COUNT"] = str(len(entries))
for index, (key, value) in enumerate(entries):
    env[f"GIT_CONFIG_KEY_{index}"] = key
    env[f"GIT_CONFIG_VALUE_{index}"] = value
# Belt and braces only: the sandbox rewrites this variable before the tool
# shell sees it. Nothing above depends on it reaching the session.
env["SSH_AUTH_SOCK"] = os.environ["SOCKET"]
sockets = settings.setdefault("sandbox", {}).setdefault("network", {}).setdefault("allowUnixSockets", [])
# Secretive's socket, when it is not the one configured, leaves the list: it
# was this script's entry, and a retired agent keeps no door into the sandbox.
secretive = "/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
sockets[:] = [s for s in sockets if not (s.endswith(secretive) and os.path.expanduser(s) != os.environ["SOCKET"])]
if os.environ["SOCKET"] not in (os.path.expanduser(s) for s in sockets):
    sockets.append(os.environ["SOCKET"])
# The sessions' tool root: every tool a session runs or caches resolves there.
root = os.environ["ROOT"]
for key in ("AQUA_ROOT_DIR", "LIMEN_AGENT_HOME", "GOPATH", "GOMODCACHE", "GOCACHE", "CARGO_HOME", "XDG_CACHE_HOME"):
    env.pop(key, None)  # re-added below in a fixed order, so a re-run rewrites nothing
env.update({
    "AQUA_ROOT_DIR": root + "/aqua",
    "LIMEN_AGENT_HOME": root + "/home",
    "GOPATH": root + "/go",
    "GOMODCACHE": root + "/go/pkg/mod",
    "GOCACHE": root + "/go-build",
    "CARGO_HOME": root + "/cargo",
    "XDG_CACHE_HOME": root + "/cache",
})
# The write list: the root, and any --write directories as given; the sandbox
# always allows a session's own working directory, so none is needed for the
# checkouts themselves. The human's
# own tool roots and TMPDIR leave it; anything this script does not know stays.
home = os.environ["USER_HOME"]
def tilde(p):
    return "~" + p[len(home):] if p.startswith(home + "/") else p
writes = [tilde(w) for w in os.environ["WRITE_DIRS"].split("\n") if w]
known = {"~/go", "~/Applications/go", "~/Library/Caches/go-build",
         "~/.local/share/aquaproj-aqua", "~/.cache/gh", "~/.sigstore", "~/.cargo"}
fs = settings.setdefault("sandbox", {}).setdefault("filesystem", {})
kept = [p for p in fs.get("allowWrite", []) if p not in known and not p.startswith("/var/folders/")]
fs["allowWrite"] = writes + [tilde(root)] + [p for p in kept if p not in writes and p != tilde(root)]
# The deny rules bind the file tools, and Read and Edit rules are also compiled
# into the sandbox as read and write denials for every command. Three facts set
# the list: a deny beats every allow, so no blanket deny on the home is possible;
# a bare pattern covers everything under it, so no /** is needed; an Edit rule
# covers Write. Reads: the credential stores of the home, by letter where the
# letter covers nothing a session must read (not .c*: ~/.claude holds the bot's
# gh token; not .l*: the agent root; not .n*: nix; not .g*: .gitconfig), and
# taciturn's key store (wrapped enclave blobs and their records: useless off
# this Mac and to a session, denied as defence in depth; the socket beside it
# stays reachable, and the audit log under ~/Library/Logs holds no secret). Never
# the keychain: a client has to open it, and gh keeps its token there. Edits:
# every dotfile letter that holds no sandbox write location (.l* and .n* do),
# the launch agents and app data, and each project's own settings and hooks.
# Paths in ~ form, which the rule engine and the sandbox both expand.
deny = settings.setdefault("permissions", {}).setdefault("deny", [])
reads = (".Trash", ".a*", ".b*", ".claude.json*", ".codex", ".config", ".d*", ".gemini",
         ".gnupg", ".lima", ".netrc", ".o*", ".p*", ".s*", ".z*",
         "Library/Accounts", "Library/Application Support/1Password",
         "Library/Application Support/Google", "Library/Application Support/taciturn/keys",
         "Library/Cookies", "Library/Group Containers",
         "Library/Mail", "Library/Messages", "Library/Safari")
edits = (".a*", ".b*", ".c*", ".d*", ".g*", ".o*", ".p*", ".rc", ".s*", ".z*",
         "Library/Application Support", "Library/LaunchAgents", "Library/Preferences")
baseline = ["Read(~/" + p + ")" for p in reads] + ["Read(**/.env)", "Read(**/.env.*)"]
baseline += ["Edit(~/" + p + ")" for p in edits]
baseline += ["Edit(./.claude/hooks)", "Edit(./.claude/settings.json)", "Edit(./.claude/settings.local.json)"]
for rule in baseline:
    if rule not in deny:
        deny.append(rule)
# The sandbox baseline, reviewed 2026-10-12 (limen's book, identity.md). Domains are
# added, never removed, so a machine's own additions survive; the exclusion list is
# set exactly, because an exclusion runs unsandboxed and the rule is one fixed,
# human-owned binary by absolute path or nothing. No mach service: the only one ever
# needed served VM boots, which cannot run sandboxed (upstream.md). Apple events off:
# nothing a session runs talks to another app. Weaker network isolation on: it adds
# the one trustd lookup Go needs to verify TLS. Local binding on: Go tests listen.
sandbox = settings.setdefault("sandbox", {})
network = sandbox.setdefault("network", {})
for key, wanted in (("allowedDomains", [
         "*.apache.org", "*.apple.com", "apple.com", "aquaproj.github.io",
         "cloudflare-dns.com", "cloudflare.com", "*.cloudflare.com", "code.claude.com",
         "*.crates.io", "crates.io", "curl.se", "cygwin.com", "discogs.com",
         "*.discogs.com", "dl.google.com", "docs.getutm.app", "docs.renovatebot.com",
         "eclecticlight.co", "farcloser.world", "*.farcloser.world", "forkcloser.org",
         "*.forkcloser.org", "*.gcr.io", "*.github.com", "github.com",
         "*.githubusercontent.com", "go.dev", "*.go.dev", "*.golang.org", "golang.org",
         "golangci-lint.run", "goreleaser.com", "keepachangelog.com",
         "*.keepachangelog.com", "*.kernel.org", "learn.microsoft.com", "lwn.net",
         "man7.org", "mozilla.org", "*.mozilla.org", "msys2.org", "*.msys2.org",
         "*.opentofu.org", "*.readthedocs.io", "readthedocs.io", "rust-lang.org",
         "*.rust-lang.org", "rustup.rs", "*.rustup.rs", "*.semver.org", "semver.org",
         "*.shellcheck.net", "sigstore.dev", "*.sigstore.dev",
         "specifications.freedesktop.org", "tmaproduction.blob.core.windows.net",
         "unicode.org", "*.unicode.org", "unlicense.org", "website-godolint.pages.dev",
         "*.wikipedia.org",
]), ("deniedDomains", [
         "uploads.github.com", "api.cloudflare.com", "dash.cloudflare.com",
         "appstoreconnect.apple.com", "api.appstoreconnect.apple.com", "desec.io",
         "*.desec.io", "api.gandi.net",
])):
    have = network.setdefault(key, [])
    for d in wanted:
        if d not in have:
            have.append(d)
network["allowMachLookup"] = []
network["allowLocalBinding"] = True
sandbox["allowAppleEvents"] = False
sandbox["enableWeakerNetworkIsolation"] = True
sandbox["excludedCommands"] = ["/Applications/UTM.app/Contents/MacOS/utmctl *"]
# The harness: transcripts kept a week (every session can read every other's), no
# background traffic from the CLI. Bypass mode cannot be refused from here:
# disableBypassPermissionsMode is honoured in managed settings only (tried 2026-10-12).
settings["cleanupPeriodDays"] = 7
env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
# The hand-kept hook that auto-allowed sandboxed commands is retired: the
# sandbox itself auto-allows them, and its exclusion regex drifted from
# excludedCommands. The file is left for the human.
pre = settings.get("hooks", {}).get("PreToolUse", [])
settings.get("hooks", {})["PreToolUse"] = [h for h in pre if "allow-sandboxed-bash" not in json.dumps(h)] if pre else pre
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  ok "Claude Code settings merged: $SETTINGS (backup: $SETTINGS.bak)"
}

verify() {
  [ -S "$AGENT_SOCKET" ] || { err "no agent socket at $AGENT_SOCKET — load the agent (taciturn install), or name another with --socket, and re-run"; exit 1; }
  local blob
  blob="$(printf '%s' "$BOT_KEY" | awk '{print $2}')"
  if ! SSH_AUTH_SOCK="$AGENT_SOCKET" /usr/bin/ssh-add -L 2>/dev/null | grep -qF "$blob"; then
    err "the agent at $AGENT_SOCKET does not serve the key in $BOT_KEY_FILE — the agent lists a key only once its policy allows something: taciturn key create <name>; taciturn key allow <name> --user git --host github.com --known-hosts $KNOWN_HOSTS; taciturn key sshsig <name> --namespace git; then re-run"
    exit 1
  fi
  ok "agent serves the bot key"
  # Outside the sandbox there is no proxy: plain ssh, pinned host keys, this
  # agent only — GitHub answers with the account the key is registered on.
  local greeting
  greeting="$(/usr/bin/ssh -o IdentityAgent="$AGENT_SOCKET" -o IdentitiesOnly=no -o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=yes -T git@github.com 2>&1 || true)"
  case "$greeting" in
    "Hi $BOT_LOGIN!"*) ok "GitHub authenticates the key as $BOT_LOGIN" ;;
    Hi\ *) err "GitHub authenticates the key as a different account: ${greeting%%!*}! — register it on $BOT_LOGIN instead"; exit 1 ;;
    *) err "GitHub did not authenticate the key: $greeting"; err "register the public key on $BOT_LOGIN as an authentication key (and as a signing key)"; exit 1 ;;
  esac
}

install_helper
pin_github_host_keys
install_agent_root
merge_settings
if [ "$VERIFY" = 1 ]; then verify; fi
ok "done — restart Claude Code sessions to pick up the settings"
log "remaining, on GitHub: invite $BOT_LOGIN as an outside collaborator (write) on each repository it may push to"
log "remaining, per repository: add the bot to .allowed_signers so \`just lint\` verifies its signatures:"
log "  $BOT_EMAIL namespaces=\"git\" $(printf '%s' "$BOT_KEY" | awk '{print $1, $2}')"
