#!/usr/bin/env bash
#
# limen-install-agent — let a Claude Code session commit and push as a
# dedicated bot identity: signed commits, over ssh, from inside its sandbox.
# Design and reasoning: limen's book/agents.md.
#
# Two traps this file works around. The Claude Code sandbox rewrites
# SSH_AUTH_SOCK to a launchd socket it then denies, even when settings.json's
# env block sets it (the rest of that block arrives intact). So the agent's
# socket travels inside what git execs — `-o IdentityAgent` in core.sshCommand
# for ssh, a one-line ssh-keygen wrapper for signing (git execs gpg.ssh.program
# directly; there is no shell in between to prefix an env) — and nothing here
# depends on the environment variable reaching the session. And the sandbox
# exports GIT_SSH_COMMAND into every command, naming a bare `ssh`, which
# outranks core.sshCommand: the sessions' ssh options file, which the fork's
# ssh reads through SSH_CONFIG_INCLUDE, makes that command work as it is
# (README, "Inside a session").
#
# The ssh client and the signer are the fork's, forkcloser/openssh from the
# machine toolset (security keys and ECDSA built in, the latter since it links
# LibreSSL), named by real path: a session's hermetic root carries no
# openssh, so the toolset's link resolves nothing there, and git execs
# gpg.ssh.program with no shell in between. The path is the pinned version's:
# a bump moves it on the next run of this script, and hermetic keeps the old
# version's files until they are pruned, so nothing breaks in between.
#
# Usage:
#   limen-install-agent [--write DIR]... [--socket PATH] [--agent-root DIR]
#                       [--no-verify] <login> <email> <public-key-file>
#
# The sessions' tool root (--agent-root, default ~/.local/share/limen-agent): a
# hermetic root of their own, a home for the verifiers, the Go, cargo and XDG
# caches. A session may write it, its own project directory (the sandbox always
# allows the working directory), and any --write directory given, exactly as
# given; nothing else of the human's: the human's own tool roots leave the
# sandbox's write list. The root gets the toolset's pins and nothing per
# repository: sessions approve policies and install pins themselves.
# Design: limen's book/identity.md, "The bot's sandbox".
#
# <public-key-file> is the bot's public key as the agent prints it (taciturn:
# `taciturn key list --format ssh`), registered on <login> BOTH as an
# authentication key and as a signing key. The agent is taciturn's, on its
# socket under ~/Library/Application Support/taciturn; --socket names another
# (a machine still on Secretive's).
#
# Idempotent: re-run to converge after any change. macOS only (the Secure Enclave).

set -euo pipefail

# Every tool this script runs is the system's, for the whole run, as in
# limen-install: on a machine that has the toolset, head, cp, ln, mkdir, awk
# and grep on PATH are a checkout's links when run from inside one, and
# resolve to nothing when run from outside, so the same command line behaves
# by the current directory. The shell's PATH follows, for hermetic in the
# root's bin.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PATH

log() { printf '› %s\n' "$*"; }
ok()  { printf '✓ %s\n' "$*"; }
err() { printf '✗ %s\n' "$*" >&2; }

AGENT_SOCKET="$HOME/Library/Application Support/taciturn/agent.sock"
VERIFY=1
AGENT_ROOT="$HOME/.local/share/limen-agent"
WRITE=()
while [ $# -gt 0 ]; do
  case "$1" in
    --socket) AGENT_SOCKET="$2"; shift 2 ;;
    --agent-root) AGENT_ROOT="$2"; shift 2 ;;
    --write) WRITE+=("${2%/}"); shift 2 ;;
    --no-verify) VERIFY=0; shift ;;
    --) shift; break ;;
    -*) err "unknown option: $1"; exit 2 ;;
    *) break ;;
  esac
done
if [ $# -ne 3 ]; then
  err "usage: limen-install-agent [--write DIR]... [--socket PATH] [--agent-root DIR] [--no-verify] <login> <email> <public-key-file>"
  exit 2
fi
for d in ${WRITE[@]+"${WRITE[@]}"}; do [ -d "$d" ] || { err "--write $d: not a directory"; exit 2; }; done
# Before anything is written: the socket is pinned into the signer wrapper, the ssh
# command and the sandbox's socket list, so a wrong default (an agent not installed
# yet) would break signing and pushing in every session. Refuse first.
[ -S "$AGENT_SOCKET" ] || { err "no agent socket at $AGENT_SOCKET — nothing written; load the agent (taciturn install), or name the live one with --socket"; exit 1; }
readonly BOT_LOGIN="$1" BOT_EMAIL="$2" BOT_KEY_FILE="$3"
BOT_KEY="$(head -n 1 "$BOT_KEY_FILE")"
readonly BOT_KEY
case "$BOT_KEY" in
  ecdsa-sha2-nistp256\ *|ssh-ed25519\ *|sk-*\ *) ;;
  *) err "$BOT_KEY_FILE does not look like an OpenSSH public key"; exit 2 ;;
esac

[ "$(uname -s)" = Darwin ] || { err "macOS only: the bot key lives in the Secure Enclave"; exit 1; }
for tool in python3 curl hermetic; do
  command -v "$tool" >/dev/null 2>&1 || { err "$tool is required (the ProxyCommand helper and the settings merge are python3; curl fetches GitHub's host keys; hermetic is the machine toolset: run limen-install first)"; exit 1; }
done
readonly AGENT_ROOT WRITE

# The fork, by real path (header). `hermetic which` reads a checkout's own
# .hermetic/hermetic.yaml before the toolset's pins in its root: resolved from
# /, where there is none. The root is the shell's, HERMETIC_ROOT_DIR or the
# binary's default, the same one limen-install filled from this shell.
MACHINE_HERMETIC="$(command -v hermetic)"
readonly MACHINE_HERMETIC
FORK_SSH="$(cd / && "$MACHINE_HERMETIC" which ssh 2>/dev/null || true)"
case "$FORK_SSH" in
  */github.com/forkcloser/openssh/*/bin/ssh) ;;
  *) err "ssh resolves to ${FORK_SSH:-nothing}, not to forkcloser/openssh from the machine toolset — run limen-install first"; exit 1 ;;
esac
readonly FORK_SSH FORK_KEYGEN="$FORK_SSH-keygen" FORK_ADD="$FORK_SSH-add"
# The fork's two clients as taciturn's peer globs: the store's package
# directory is version, archive, archive directory, bin, so the version-bearing
# components are globbed and a pin bump keeps the key's peers. One glob per
# root, never a root as a whole: a binary a session planted elsewhere is no peer.
readonly FORK_GLOB="${FORK_SSH%/openssh/*}/openssh/*/*/*/bin"
[ -x "$FORK_KEYGEN" ] && [ -x "$FORK_ADD" ] || { err "no ssh-keygen and ssh-add beside $FORK_SSH"; exit 1; }
# The bot has one key, and ssh offers a key only when its algorithm is in the
# accepted list; the fork's default list carries no ECDSA. A named list, the
# key's own algorithm and nothing else — never `+`, which re-admits the default set.
readonly KEY_ALGO="${BOT_KEY%% *}"
# The fork must know the key's algorithm: a build without it (the toolset's
# v10.6.1, which the nightly pinned back) lists no such key from the agent and
# verify would blame the agent for what the client dropped.
if ! "$FORK_SSH" -Q key 2>/dev/null | grep -qxF "$KEY_ALGO"; then
  err "$FORK_SSH does not support $KEY_ALGO keys (ssh -Q key) — run limen-install to converge the toolset on a build that does, then re-run"
  exit 1
fi

# Claude Code's configuration home; CLAUDE_CONFIG_DIR is its own override.
readonly CLAUDE_HOME="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
readonly HELPER="$CLAUDE_HOME/bin/ssh-connect-proxy"
readonly SIGNER="$CLAUDE_HOME/bin/ssh-keygen-agent"
readonly KNOWN_HOSTS="$CLAUDE_HOME/known_hosts"
readonly GITCONFIG="$CLAUDE_HOME/gitconfig" GITIGNORE="$CLAUDE_HOME/gitignore"
readonly SETTINGS="$CLAUDE_HOME/settings.json"
readonly AGENT_HERMETIC="$AGENT_ROOT/hermetic" AGENT_HOME="$AGENT_ROOT/home"
readonly SESSION_SSH_CONFIG="$AGENT_ROOT/ssh_config"
readonly AGENT_FORK_GLOB="$AGENT_HERMETIC/store/pkgs/github_release/github.com/forkcloser/openssh/*/*/*/bin"

install_helper() {
  mkdir -p "$CLAUDE_HOME/bin"
  cat > "$HELPER" <<'PY'
#!/usr/bin/env python3
"""ssh ProxyCommand for the Claude Code sandbox: an authenticated HTTP CONNECT tunnel.

The sandbox routes every outbound connection through a per-session proxy that
requires credentials. It hands them to HTTP clients via HTTPS_PROXY, but the
ssh ProxyCommand it configures (a bare `nc -X 5`) offers none, so ssh is
refused. This helper speaks CONNECT with those credentials, then relays bytes
between ssh and the tunnel. Installed by limen-install-agent; the proxy's port
and credentials are read from the environment at run time.

usage (as ssh sees it): ssh-connect-proxy %h %p
"""
import base64
import os
import select
import socket
import sys
from urllib.parse import unquote, urlsplit


def proxy_from_env():
    for name in ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy", "HTTP_PROXY", "http_proxy"):
        value = os.environ.get(name)
        if value:
            parts = urlsplit(value)
            if parts.hostname and parts.port:
                return parts
    sys.exit("ssh-connect-proxy: no HTTP proxy in the environment (not inside the Claude Code sandbox?)")


def relay(sock, out):
    fin = sys.stdin.buffer.fileno()
    while True:
        readable, _, _ = select.select([sock, fin], [], [])
        if sock in readable:
            data = sock.recv(65536)
            if not data:
                return
            out.write(data)
            out.flush()
        if fin in readable:
            data = os.read(fin, 65536)
            if not data:
                sock.shutdown(socket.SHUT_WR)
                while True:
                    tail = sock.recv(65536)
                    if not tail:
                        return
                    out.write(tail)
                    out.flush()
            sock.sendall(data)


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: ssh-connect-proxy host port")
    host, port = sys.argv[1], sys.argv[2]
    proxy = proxy_from_env()
    sock = socket.create_connection((proxy.hostname, proxy.port))
    request = f"CONNECT {host}:{port} HTTP/1.1\r\nHost: {host}:{port}\r\n"
    if proxy.username:
        credentials = f"{unquote(proxy.username)}:{unquote(proxy.password or '')}".encode()
        request += "Proxy-Authorization: Basic " + base64.b64encode(credentials).decode() + "\r\n"
    sock.sendall((request + "\r\n").encode())
    buffer = b""
    while b"\r\n\r\n" not in buffer:
        chunk = sock.recv(4096)
        if not chunk:
            sys.exit("ssh-connect-proxy: proxy closed the connection during CONNECT")
        buffer += chunk
    head, rest = buffer.split(b"\r\n\r\n", 1)
    status = head.split(b"\r\n", 1)[0].decode(errors="replace")
    if " 200" not in status:
        sys.exit(f"ssh-connect-proxy: CONNECT {host}:{port} refused: {status}")
    out = sys.stdout.buffer
    if rest:
        out.write(rest)
        out.flush()
    relay(sock, out)


if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, ConnectionResetError):
        pass
PY
  chmod 0755 "$HELPER"
  ok "ProxyCommand helper: $HELPER"

  # ssh-keygen -Y sign reaches the agent only through SSH_AUTH_SOCK, and git
  # execs gpg.ssh.program directly — so the socket is pinned in a wrapper.
  cat > "$SIGNER" <<SH
#!/bin/sh
# Written by limen-install-agent: the fork's ssh-keygen (forkcloser/openssh, the
# machine toolset's pin, by real path) with the agent socket pinned, because the
# Claude Code sandbox rewrites SSH_AUTH_SOCK to a socket it then denies.
SSH_AUTH_SOCK='$AGENT_SOCKET'
export SSH_AUTH_SOCK
exec '$FORK_KEYGEN' "\$@"
SH
  chmod 0755 "$SIGNER"
  ok "signing wrapper: $SIGNER"
}

pin_github_host_keys() {
  # GitHub publishes its host keys at api.github.com/meta; pinned here so the
  # sandbox (denied ~/.ssh) verifies the host strictly, never trust-on-first-use.
  local meta
  meta="$(curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-delay 3 --retry-all-errors https://api.github.com/meta)"
  {
    echo "# GitHub's ssh host keys, from https://api.github.com/meta — written by limen-install-agent."
    echo "# Compare against https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/githubs-ssh-key-fingerprints"
    printf '%s' "$meta" | python3 -c 'import json,sys; [print("github.com", k) for k in json.load(sys.stdin)["ssh_keys"]]'
  } > "$KNOWN_HOSTS"
  chmod 0644 "$KNOWN_HOSTS"
  ok "GitHub host keys pinned: $KNOWN_HOSTS ($(grep -c '^github.com ' "$KNOWN_HOSTS") keys)"
}

# The sessions' hermetic root: the toolset's pins, copied from the machine's
# root (hermetic.yaml, registry.yaml, policy.yaml and the checksums limen-install
# wrote), so a session resolves limen and the fork by name through the same
# binary, into a store of its own, lazily on first use. Its bin/hermetic is a
# symlink to the machine's binary, never a copy: every link hermetic plants in
# a root's bin points at that root's bin/hermetic and it links nothing into a
# root that has none, and a copy is the pinned version of the day it was made
# while the link follows the nightly bump. The recipes' PATH is this bin and the
# base system, so this is the one hermetic a session's recipes see; it reads
# HERMETIC_ROOT_DIR from the sessions' settings. Nothing per repository: a
# session approves a checkout's policy and installs its pins itself, into this
# root.
install_agent_root() {
  mkdir -p "$AGENT_HERMETIC/bin" "$AGENT_HOME" "$AGENT_ROOT/go" "$AGENT_ROOT/go-build" "$AGENT_ROOT/cargo" "$AGENT_ROOT/cache" "$AGENT_ROOT/sigstore" "$AGENT_ROOT/share"
  local machine_root f
  machine_root="$(cd / && "$MACHINE_HERMETIC" root-dir)"
  machine_root="${machine_root%/store}"
  for f in hermetic.yaml registry.yaml policy.yaml aqua-checksums.json; do
    [ -f "$machine_root/$f" ] || { err "$machine_root/$f is missing — run limen-install first"; exit 1; }
    cp "$machine_root/$f" "$AGENT_HERMETIC/$f"
  done
  [ -x "$machine_root/bin/hermetic" ] || { err "$machine_root/bin/hermetic is missing — run limen-install first"; exit 1; }
  # -f replaces a copy an earlier hand or run left; -n keeps ln from following
  # an existing link (the spelling BSD and GNU ln share; BSD's -h is GNU's
  # --help).
  ln -sfn "$machine_root/bin/hermetic" "$AGENT_HERMETIC/bin/hermetic"
  [ "$(cd / && HERMETIC_ROOT_DIR="$AGENT_HERMETIC" "$AGENT_HERMETIC/bin/hermetic" version)" = "$("$MACHINE_HERMETIC" version)" ] || { err "$AGENT_HERMETIC/bin/hermetic does not run the machine's hermetic"; exit 1; }
  ok "sessions' tool root: $AGENT_ROOT (hermetic $("$MACHINE_HERMETIC" version) through $AGENT_HERMETIC/bin/hermetic, pins from $machine_root)"
}

# The sessions' git configuration: one file under the Claude Code home, which a
# session reads and cannot write (same standing as the gh token), named by
# GIT_CONFIG_GLOBAL in the settings env. git then reads neither the human's
# ~/.gitconfig nor ~/.config/git, so neither needs to be readable, and the
# human's symlinked config can live wherever it likes. Rewritten whole on every
# run, so the file converges with the installer.
install_gitconfig() {
  local ssh_command
  # IdentityAgent pins the enclave agent whatever SSH_AUTH_SOCK says (the
  # sandbox rewrites it); IdentitiesOnly=no lets the agent's key be offered.
  # git hands core.sshCommand to sh, which strips one level of quotes before ssh
  # parses the option, so a socket path with a space ("Application Support")
  # needs ssh_config's own double quotes inside the shell's single quotes.
  ssh_command="'$FORK_SSH' -o 'IdentityAgent=\"$AGENT_SOCKET\"' -o IdentitiesOnly=no -o PubkeyAcceptedAlgorithms=$KEY_ALGO -o ProxyCommand='python3 $HELPER %h %p' -o UserKnownHostsFile=$KNOWN_HOSTS -o StrictHostKeyChecking=yes -o ControlMaster=no -o ControlPath=none"
  : > "$GITIGNORE"
  : > "$GITCONFIG"
  local g=(git config --file "$GITCONFIG")
  "${g[@]}" user.name "$BOT_LOGIN"
  "${g[@]}" user.email "$BOT_EMAIL"
  "${g[@]}" user.signingkey "key::$BOT_KEY"
  "${g[@]}" gpg.format ssh
  # The wrapper around the fork's ssh-keygen with the agent socket pinned
  # inside it — see the header on SSH_AUTH_SOCK.
  "${g[@]}" gpg.ssh.program "$SIGNER"
  "${g[@]}" commit.gpgsign true
  "${g[@]}" core.sshCommand "$ssh_command"
  # An empty excludes file: git's default is ~/.config/git/ignore, which the
  # sandbox denies, and it warns on every command otherwise.
  "${g[@]}" core.excludesFile "$GITIGNORE"
  # Transitional: goes once the fork release with the ssh_config include is
  # the machine's pin.
  "${g[@]}" alias.c '!env -u GIT_SSH_COMMAND git'
  # The harness protects every .git/config under a session's root, and a push
  # that sets an upstream writes it; the branch needs no upstream for a PR.
  "${g[@]}" push.autosetupremote false
  # https reads (a go module of a private repository) authenticate with the
  # bot's gh token; the leading empty helper drops any system default.
  "${g[@]}" --replace-all credential.https://github.com.helper ''
  "${g[@]}" --add credential.https://github.com.helper '!gh auth git-credential'
  chmod 0644 "$GITCONFIG" "$GITIGNORE"
  ok "sessions' git configuration: $GITCONFIG"
}

# No ProxyCommand here: the sandbox's GIT_SSH_COMMAND carries its own. ssh
# refuses an included file that is group- or world-writable, hence the mode.
install_session_ssh_config() {
  mkdir -p "$(dirname "$SESSION_SSH_CONFIG")"
  cat > "$SESSION_SSH_CONFIG" <<CONF
# Written by limen-install-agent: a Claude session's ssh client options,
# included through SSH_CONFIG_INCLUDE. Rewritten whole on every run.
IdentityAgent "$AGENT_SOCKET"
IdentitiesOnly no
PubkeyAcceptedAlgorithms $KEY_ALGO
UserKnownHostsFile $KNOWN_HOSTS
StrictHostKeyChecking yes
CONF
  chmod 0644 "$SESSION_SSH_CONFIG"
  ok "sessions' ssh client options: $SESSION_SSH_CONFIG"
}

merge_settings() {
  mkdir -p "$CLAUDE_HOME"
  [ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
  cp "$SETTINGS" "$SETTINGS.bak"
  SOCKET="$AGENT_SOCKET" GITCONFIG_PATH="$GITCONFIG" \
  ROOT="$AGENT_ROOT" WRITE_DIRS="$(printf '%s\n' ${WRITE[@]+"${WRITE[@]}"})" USER_HOME="$HOME" \
  python3 - "$SETTINGS" <<'PY'
import json, os, string, sys
path = sys.argv[1]
with open(path) as f:
    settings = json.load(f)
env = settings.setdefault("env", {})
# The git identity used to be a numbered GIT_CONFIG_* block here; it is now the
# file GIT_CONFIG_GLOBAL names. The numbered keys are the installer's own output
# and are removed so the file converges. The socket is re-added below in place.
for key in [k for k in env if k.startswith("GIT_CONFIG_") or k == "SSH_AUTH_SOCK"]:
    del env[key]
env["GIT_CONFIG_GLOBAL"] = os.environ["GITCONFIG_PATH"]
# Belt and braces only: the sandbox rewrites this variable before the tool
# shell sees it. Nothing above depends on it reaching the session.
env["SSH_AUTH_SOCK"] = os.environ["SOCKET"]
sockets = settings.setdefault("sandbox", {}).setdefault("network", {}).setdefault("allowUnixSockets", [])
# Secretive's socket, when it is not the one configured, leaves the list: it
# was this script's entry, and a retired agent keeps no door into the sandbox.
secretive = "/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"
sockets[:] = [s for s in sockets if not (s.endswith(secretive) and os.path.expanduser(s) != os.environ["SOCKET"])]
if os.environ["SOCKET"] not in (os.path.expanduser(s) for s in sockets):
    sockets.append(os.environ["SOCKET"])
# The sessions' tool root: every tool a session runs or caches resolves there.
# The aqua variables of the previous installer go: hermetic derives the
# library's from HERMETIC_ROOT_DIR and scrubs every AQUA_* it is given.
root = os.environ["ROOT"]
for key in ("AQUA_ROOT_DIR", "AQUA_GLOBAL_CONFIG", "AQUA_POLICY_CONFIG", "HERMETIC_ROOT_DIR", "LIMEN_AGENT_HOME", "GOPATH", "GOMODCACHE", "GOCACHE", "CARGO_HOME", "XDG_CACHE_HOME", "TUF_ROOT", "XDG_DATA_HOME", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC", "SSH_CONFIG_INCLUDE"):
    env.pop(key, None)  # re-added below in a fixed order, so a re-run rewrites nothing
env.update({
    "HERMETIC_ROOT_DIR": root + "/hermetic",
    "LIMEN_AGENT_HOME": root + "/home",
    "GOPATH": root + "/go",
    "GOMODCACHE": root + "/go/pkg/mod",
    "GOCACHE": root + "/go-build",
    "CARGO_HOME": root + "/cargo",
    "XDG_CACHE_HOME": root + "/cache",
    # cosign reads TUF_ROOT for its trusted-root cache (slsa-verifier reads HOME
    # only, which the env prefix on the aqua recipes covers).
    "TUF_ROOT": root + "/sigstore",
    # gh keeps its extensions under XDG_DATA_HOME/gh; the sessions install the
    # gh-stack extension there, into their own root, and verify its attestation.
    "XDG_DATA_HOME": root + "/share",
    # No background traffic from the CLI. Set here, in the one fixed-order
    # block, and not after it: a key written outside the block lands at the
    # end on the first run and behind the re-added block on the next, so a
    # converged file changed bytes.
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "SSH_CONFIG_INCLUDE": root + "/ssh_config",
})
# The write list: the root, and any --write directories as given; the sandbox
# always allows a session's own working directory, so none is needed for the
# checkouts themselves. The human's
# own tool roots and TMPDIR leave it; anything this script does not know stays.
home = os.environ["USER_HOME"]
def tilde(p):
    return "~" + p[len(home):] if p.startswith(home + "/") else p
writes = [tilde(w) for w in os.environ["WRITE_DIRS"].split("\n") if w]
known = {"~/go", "~/Applications/go", "~/Library/Caches/go-build",
         "~/.local/share/aquaproj-aqua", "~/Library/Application Support/hermetic",
         "~/.cache/gh", "~/.sigstore", "~/.cargo"}
fs = settings.setdefault("sandbox", {}).setdefault("filesystem", {})
kept = [p for p in fs.get("allowWrite", []) if p not in known and not p.startswith("/var/folders/")]
fs["allowWrite"] = writes + [tilde(root)] + [p for p in kept if p not in writes and p != tilde(root)]
# The deny rules bind the file tools, and Read and Edit rules are also compiled
# into the sandbox as read and write denials for every command. Three facts set
# the list: a deny beats every allow, so no blanket deny on the home is possible;
# a bare pattern covers everything under it, so no /** is needed; an Edit rule
# covers Write. Reads: the credential stores of the home, by letter where the
# letter covers nothing a session must read (not .c*: ~/.claude holds the bot's
# gh token; not .l*: the agent root; not .n*: nix; not .g*: .gitconfig), and
# taciturn's key store (wrapped enclave blobs and their records: useless off
# this Mac and to a session, denied as defence in depth; the socket beside it
# stays reachable, and the audit log under ~/Library/Logs holds no secret). Never
# the keychain: a client has to open it, and gh keeps its token there. Edits:
# every dotfile letter that holds no sandbox write location (.l* and .n* do),
# the launch agents and app data, and each project's own settings and hooks.
# Then every letter of the home, both cases: a read deny on each letter except
# A (Applications: the Go toolchain), L (Library: its stores are denied one by
# one above, the rest is cache a session reads), P (Projects: the session roots;
# Pictures and Public are denied by their first two letters), and an edit deny
# on each letter except L and P. V (Vault) is denied since GIT_CONFIG_GLOBAL
# keeps git away from the human's ~/.gitconfig, a symlink into it. A rule on a
# letter is future-proof: a directory created tomorrow is denied the day it
# appears. Paths in ~ form, which the rule engine and the sandbox both expand.
# The force push's allow rule, a prefix match; the `git c` form stays beside
# it until the alias goes.
allow = settings.setdefault("permissions", {}).setdefault("allow", [])
for rule in ("Bash(git push --force-with-lease=*)",):
    if rule not in allow:
        allow.append(rule)
deny = settings.setdefault("permissions", {}).setdefault("deny", [])
reads = (".Trash", ".a*", ".b*", ".claude.json*", ".codex", ".config", ".d*", ".gemini",
         ".gnupg", ".lima", ".netrc", ".o*", ".p*", ".s*", ".z*",
         "Library/Accounts", "Library/Application Support/1Password",
         "Library/Application Support/Google", "Library/Application Support/taciturn/keys",
         "Library/Cookies", "Library/Group Containers",
         "Library/Mail", "Library/Messages", "Library/Safari")
edits = (".a*", ".b*", ".c*", ".d*", ".g*", ".local/bin", ".local/share/claude", ".o*",
         ".p*", ".rc", ".s*", ".z*",
         "Library/Application Support", "Library/LaunchAgents", "Library/Preferences")
letters = [c + "*" for c in string.ascii_letters]
read_skip, edit_skip = "alpALP", "lpLP"
baseline = ["Read(~/" + p + ")" for p in reads] + ["Read(**/.env)", "Read(**/.env.*)"]
baseline += ["Read(~/" + l + ")" for l in letters if l[0] not in read_skip] + ["Read(~/Pi*)", "Read(~/Pu*)"]
baseline += ["Edit(~/" + p + ")" for p in edits]
baseline += ["Edit(~/" + l + ")" for l in letters if l[0] not in edit_skip] + ["Edit(~/Pi*)", "Edit(~/Pu*)"]
baseline += ["Edit(./.claude/hooks)", "Edit(./.claude/settings.json)", "Edit(./.claude/settings.local.json)"]
# No session reads or writes a file outside the allowed locations, and none
# runs a shell command outside the Bash sandbox. Bash is sandboxed and its
# escape hatch is off (below); these MCP tools are the other ways a session
# does either on the host, each denied by name: the desktop app's Terminal
# panel (a command typed into the human's own shell; reading the panel is
# not in the list), the whole GoLand server (its terminal, run configurations,
# external tools, builds and inspection scripts execute on the host, and its
# file tools read, write and rename through the IDE, outside the sandbox's
# rules), the iOS simulator's build (xcodebuild runs the project's script
# phases unsandboxed; the simulator's controls stay, a controlled tool that
# runs no shell, and the build itself runs from sandboxed Bash), the browser
# pane's dev server start (a command from launch.json on the host; inspecting
# its tabs stays), and the desktop app's host actions (a git merge with the
# human's own identity, worktree deletion, opening an editor or the Finder).
# A tool a session does not have costs nothing to deny.
host = ("mcp__terminal__run_in_terminal", "mcp__terminal__open_terminal_tab", "mcp__terminal__stop_terminal_tab",
        "mcp__goland",
        "mcp__Claude_Code_iOS_Simulator__build",
        "mcp__Claude_Browser__preview_start",
        "mcp__ccd_host__sync_with_base_branch", "mcp__ccd_host__clean_up_worktrees",
        "mcp__ccd_host__discard_kept_worktree", "mcp__ccd_host__open_in_editor", "mcp__ccd_host__reveal_path")
baseline += list(host)
for rule in baseline:
    if rule not in deny:
        deny.append(rule)
# The sandbox baseline, reviewed 2026-10-12 (limen's book, identity.md). Domains are
# added, never removed, so a machine's own additions survive; the exclusion list is
# set exactly, because an exclusion runs unsandboxed and the rule is one fixed,
# human-owned binary by absolute path or nothing. No mach service: the only one ever
# needed served VM boots, which cannot run sandboxed (upstream.md). Apple events off:
# nothing a session runs talks to another app. Weaker network isolation on: it adds
# the one trustd lookup Go needs to verify TLS. Local binding on: Go tests listen.
sandbox = settings.setdefault("sandbox", {})
network = sandbox.setdefault("network", {})
for key, wanted in (("allowedDomains", [
         "*.apache.org", "*.apple.com", "apple.com", "aquaproj.github.io",
         "cloudflare-dns.com", "cloudflare.com", "*.cloudflare.com", "code.claude.com",
         "*.crates.io", "crates.io", "curl.se", "cygwin.com", "discogs.com",
         "*.discogs.com", "dl.google.com", "docs.getutm.app", "docs.renovatebot.com",
         "eclecticlight.co", "farcloser.world", "*.farcloser.world", "forkcloser.org",
         "*.forkcloser.org", "*.gcr.io",
         # a project-local Homebrew fetches its portable Ruby here, and
         # `brew style` its gems from rubygems; read-only registries
         "ghcr.io", "rubygems.org", "*.rubygems.org",
         "*.github.com", "github.com",
         "*.githubusercontent.com", "go.dev", "*.go.dev", "*.golang.org", "golang.org",
         "golangci-lint.run", "goreleaser.com", "keepachangelog.com",
         "*.keepachangelog.com", "*.kernel.org", "learn.microsoft.com", "lwn.net",
         "man7.org", "mozilla.org", "*.mozilla.org", "msys2.org", "*.msys2.org",
         "*.opentofu.org", "*.readthedocs.io", "readthedocs.io", "rust-lang.org",
         "*.rust-lang.org", "rustup.rs", "*.rustup.rs", "*.semver.org", "semver.org",
         "*.shellcheck.net", "sigstore.dev", "*.sigstore.dev",
         "specifications.freedesktop.org",
         # proxy.golang.org redirects module downloads here
         "storage.googleapis.com", "tmaproduction.blob.core.windows.net",
         # GitHub redirects Actions job logs and artifacts to numbered storage
         # accounts of its own; `gh run view --log` and `gh run download` read from
         # them. The first twenty were seen first, then productionresultssa31: the
         # list runs to 63, the next power of two. Named one by one: the proxy
         # takes no label-prefix wildcard, and the apex *.blob.core.windows.net
         # would open every Azure storage account.
         *["productionresultssa%d.blob.core.windows.net" % i for i in range(64)],
         "unicode.org", "*.unicode.org", "unlicense.org", "website-godolint.pages.dev",
         "*.wikipedia.org",
]), ("deniedDomains", [
         "uploads.github.com", "api.cloudflare.com", "dash.cloudflare.com",
         "appstoreconnect.apple.com", "api.appstoreconnect.apple.com", "desec.io",
         "*.desec.io", "api.gandi.net",
])):
    have = network.setdefault(key, [])
    for d in wanted:
        if d not in have:
            have.append(d)
network["allowMachLookup"] = []
network["allowLocalBinding"] = True
sandbox["allowAppleEvents"] = False
sandbox["enableWeakerNetworkIsolation"] = True
sandbox["excludedCommands"] = ["/Applications/UTM.app/Contents/MacOS/utmctl *"]
# The harness: transcripts kept a week (every session can read every other's); the
# CLI's background traffic is off in the env block above. Bypass mode cannot be
# refused from here: disableBypassPermissionsMode is honoured in managed settings
# only (tried 2026-10-12).
settings["cleanupPeriodDays"] = 7
# The hand-kept hook that auto-allowed sandboxed commands is retired: the
# sandbox itself auto-allows them, and its exclusion regex drifted from
# excludedCommands. The file is left for the human.
pre = settings.get("hooks", {}).get("PreToolUse", [])
settings.get("hooks", {})["PreToolUse"] = [h for h in pre if "allow-sandboxed-bash" not in json.dumps(h)] if pre else pre
with open(path, "w") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
PY
  ok "Claude Code settings merged: $SETTINGS (backup: $SETTINGS.bak)"
}

verify() {
  [ -S "$AGENT_SOCKET" ] || { err "no agent socket at $AGENT_SOCKET — load the agent (taciturn install), or name another with --socket, and re-run"; exit 1; }
  local blob
  blob="$(printf '%s' "$BOT_KEY" | awk '{print $2}')"
  if ! SSH_AUTH_SOCK="$AGENT_SOCKET" "$FORK_ADD" -L 2>/dev/null | grep -qF "$blob"; then
    err "the agent at $AGENT_SOCKET does not serve the key in $BOT_KEY_FILE — the agent lists a key only once its policy allows something: taciturn key create <name> -use locked -peers 'path=$FORK_GLOB/ssh,path=$FORK_GLOB/ssh-keygen'; taciturn key allow <name> --user git --host github.com --known-hosts $KNOWN_HOSTS; taciturn key sshsig <name> --namespace git; then re-run"
    exit 1
  fi
  ok "agent serves the bot key"
  # Outside the sandbox there is no proxy: the fork's ssh as the sessions run
  # it, pinned host keys, this agent only — GitHub answers with the account the
  # key is registered on.
  local output greeting
  output="$("$FORK_SSH" -o "IdentityAgent=\"$AGENT_SOCKET\"" -o IdentitiesOnly=no -o "PubkeyAcceptedAlgorithms=$KEY_ALGO" -o UserKnownHostsFile="$KNOWN_HOSTS" -o StrictHostKeyChecking=yes -T git@github.com 2>&1 || true)"
  # GitHub's greeting is one line of that output, on the same stream as ssh's
  # own warnings, which come first (the IP address of the pinned host being
  # recorded, on a first connection): the line is read, not the output.
  greeting="$(printf '%s\n' "$output" | grep -m1 '^Hi ' || true)"
  case "$greeting" in
    "Hi $BOT_LOGIN!"*) ok "GitHub authenticates the key as $BOT_LOGIN" ;;
    Hi\ *) err "GitHub authenticates the key as a different account: ${greeting%%!*}! — register it on $BOT_LOGIN instead"; exit 1 ;;
    *)
      # "agent refused operation" is the agent's own answer, before GitHub is
      # asked anything: the key's peers do not name the client that asked. The
      # peers are the fork's clients by store path, and the store moves with the
      # root (an aqua root to hermetic's), so the entries name the old path. The
      # key's name is the comment taciturn prints with the public key.
      if printf '%s\n' "$output" | grep -q 'agent refused operation'; then
        local key_name
        key_name="$(printf '%s' "$BOT_KEY" | awk '{print $3}')"
        err "the agent refused to sign with the key: its peers do not name the fork's clients under $FORK_GLOB (the store moved with the root?) — taciturn key peers ${key_name:-<name>} -add 'path=$FORK_GLOB/ssh' -add 'path=$FORK_GLOB/ssh-keygen', and the same under the sessions' root, 'path=$AGENT_FORK_GLOB/ssh' and 'path=$AGENT_FORK_GLOB/ssh-keygen'"
        exit 1
      fi
      err "GitHub did not authenticate the key: $output"; err "register the public key on $BOT_LOGIN as an authentication key (and as a signing key)"; exit 1 ;;
  esac
}

