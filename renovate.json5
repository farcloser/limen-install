{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Default preset: detects owner/repo@ver and go-module packages in aqua.yaml,
    // updates the standard-registry ref, and bumps aqua_version in CI/devcontainer too.
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // Supply-chain cooldown: wait before proposing a bump. Doubles as protection
  // against the race where a release tag exists but its assets aren't uploaded yet.
  minimumReleaseAge: "3 days",
  // `just do lint commits` enforces DCO on every PR range, bot commits included.
  commitBody: "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  // The update-aqua-checksum workflow pushes a fix-up commit onto Renovate's
  // branches; without this, Renovate treats the branch as human-modified and
  // stops rebasing it.
  gitIgnoredAuthors: [
    "300983632+limen-ci-farcloser[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com",
  ],
  customManagers: [
    // The limen-install script carries pins of its own, each keyed on a
    // marker comment. Leading-marker form — `# renovate: depName=…` above a
    // `readonly NAME="ver"` line: today aquaproj/aqua-installer (whose
    // companion sha256 is recomputed on Renovate's branches by
    // update-installer-checksum.yaml; without that workflow the bump would
    // fail checksum verification) and aquaproj/aqua (no checksum companion —
    // the verified installer performs that download). Trailing-marker form —
    // the farcloser/limen package pin inside the embedded global aqua config
    // heredoc: Renovate groups it with the same dep's pin in aqua.yaml
    // (managed by the aqua preset), so the repo's dev pin and what new
    // machines install move in one PR; no checksum follow-up, the
    // machine-side aqua-checksums.json is generated at install time, never
    // committed here. (The equivalent pins in .github/actions/setup-aqua are
    // deliberately NOT managed here: that file is limen-canonical, pinned
    // byte-for-byte, and moves through limen baseline releases.)
    {
      customType: "regex",
      managerFilePatterns: ["/^limen-install$/"],
      matchStrings: [
        "# renovate: depName=(?<depName>[^\\s]+)\\n\\s*readonly [A-Z_]+=\"(?<currentValue>[^\"]+)\"",
        "name: [^@\\s]+@(?<currentValue>[^\\s]+) # renovate: depName=(?<depName>[^\\s]+)",
      ],
      datasourceTemplate: "github-releases",
    },
  ],
}
