{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>farcloser/limen#v0.1.1",
    "config:recommended",
    // Also bumps aqua_version in CI/devcontainer files, not only aqua.yaml.
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // Supply-chain cooldown: wait before proposing a bump. Doubles as protection
  // against the race where a release tag exists but its assets aren't uploaded yet.
  minimumReleaseAge: "3 days",
  // Explicit, not the preset default: Dependabot alerts stay on, Dependabot
  // PRs off (Renovate is the one bot); fix PRs skip the cooldown above.
  vulnerabilityAlerts: {
    enabled: true,
  },
  // `just do lint commits` enforces DCO on every PR range, bot commits included.
  commitBody: "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  // The update-aqua-checksum workflow pushes a fix-up commit onto Renovate's
  // branches; without this, Renovate treats the branch as human-modified and
  // stops rebasing it.
  gitIgnoredAuthors: [
    "300983632+limen-ci-farcloser[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com",
  ],
  customManagers: [
    // Two marker forms in ./limen-install: leading (`# renovate:` above a
    // `readonly X="ver"`) and trailing (the farcloser/limen pin inside the
    // heredoc, grouped with aqua.yaml's). aqua-installer's sha256 companion is
    // recomputed by update-installer-checksum.yaml. setup-aqua's pins are
    // deliberately NOT managed here: limen-canonical.
    {
      customType: "regex",
      managerFilePatterns: ["/^limen-install$/"],
      matchStrings: [
        "# renovate: depName=(?<depName>[^\\s]+)\\n\\s*readonly [A-Z_]+=\"(?<currentValue>[^\"]+)\"",
        "name: [^@\\s]+@(?<currentValue>[^\\s]+) # renovate: depName=(?<depName>[^\\s]+)",
      ],
      datasourceTemplate: "github-releases",
    },
  ],
}
